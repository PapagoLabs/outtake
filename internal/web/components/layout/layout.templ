// Package layout renders the authenticated document shell and sidebar.
package layout

import (
	"github.com/PapagoLabs/outtake/internal/web/components/brand"
	"github.com/PapagoLabs/outtake/internal/web/components/separator"
	"github.com/PapagoLabs/outtake/internal/web/utils"
)

type Props struct {
	Title   string
	Active  string
	Library string
}

templ Layout(props Props) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ props.Title } - Outtake</title>
			@brand.IconHead()
			<script src="/assets/js/theme.js"></script>
			<link href="/assets/css/output.css" rel="stylesheet"/>
			<script src="/assets/js/htmx.min.js"></script>
			<script src="/assets/js/app.js" defer></script>
		</head>
		<body class="min-h-screen bg-background text-foreground">
			<div class="flex min-h-screen">
				<button
					type="button"
					class="js-sidebar-open md:hidden fixed z-30 top-3 left-3 inline-flex size-9 items-center justify-center rounded-md border bg-card text-foreground shadow-xs"
					aria-label="Open menu"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h16"></path></svg>
				</button>
				<div class="js-sidebar-overlay hidden md:hidden fixed inset-0 z-40 bg-black/50"></div>
				<aside class="js-sidebar fixed md:static inset-y-0 left-0 z-50 w-64 -translate-x-full md:translate-x-0 border-r border-sidebar-border bg-sidebar p-4 flex flex-col gap-2 transition-transform">
					<div class="flex items-center justify-between gap-2 mb-4">
						<a href="/" class="flex items-center gap-2.5 text-sidebar-foreground">
							<img src="/assets/brand/mascot-128.png" width="32" height="32" alt="" class="size-8"/>
							<h1 class="text-xl font-bold">Outtake</h1>
						</a>
						<div class="flex items-center gap-1">
							<button type="button" class="js-theme-toggle inline-flex size-8 items-center justify-center rounded-md text-sidebar-foreground hover:bg-sidebar-accent" aria-label="Toggle theme">
								<svg class="js-theme-icon-dark size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
								<svg class="js-theme-icon-light size-4 hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
							</button>
							<button type="button" class="js-sidebar-close md:hidden inline-flex size-8 items-center justify-center rounded-md text-sidebar-foreground hover:bg-sidebar-accent" aria-label="Close menu">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
							</button>
						</div>
					</div>
					<a
						href="/"
						class={ utils.TwMerge(
							"px-3 py-2 rounded-md text-sm font-medium transition-colors",
							utils.IfElse(props.Active == "dashboard", "bg-sidebar-primary text-sidebar-primary-foreground", "text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"),
						) }
					>
						Dashboard
					</a>
					<div class="flex flex-col gap-1">
						<a
							href="/media"
							class={ utils.TwMerge(
								"px-3 py-2 rounded-md text-sm font-medium transition-colors",
								utils.IfElse(props.Active == "media", "bg-sidebar-primary text-sidebar-primary-foreground", "text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"),
							) }
						>
							Media Libraries
						</a>
						<div
							id="nav-libraries"
							class="flex flex-col gap-1 pl-2"
							if props.Library != "" {
								hx-get={ "/nav/libraries?library=" + props.Library }
							} else {
								hx-get="/nav/libraries"
							}
							hx-trigger="load"
							hx-swap="innerHTML"
						></div>
					</div>
					<a
						href="/clips"
						class={ utils.TwMerge(
							"px-3 py-2 rounded-md text-sm font-medium transition-colors",
							utils.IfElse(props.Active == "clips", "bg-sidebar-primary text-sidebar-primary-foreground", "text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"),
						) }
					>
						Clips
					</a>
					<div class="flex flex-col gap-1">
						<span class="px-3 py-2 text-sm font-medium text-sidebar-foreground">Settings</span>
						<div class="flex flex-col gap-1 pl-2">
							<a
								href="/servers"
								class={ utils.TwMerge(
									"px-3 py-1.5 rounded-md text-xs font-medium transition-colors",
									utils.IfElse(props.Active == "servers", "bg-sidebar-primary text-sidebar-primary-foreground", "text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"),
								) }
							>
								Servers
							</a>
							<a
								href="/settings/profiles"
								class={ utils.TwMerge(
									"px-3 py-1.5 rounded-md text-xs font-medium transition-colors",
									utils.IfElse(props.Active == "profiles", "bg-sidebar-primary text-sidebar-primary-foreground", "text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"),
								) }
							>
								Clip Profiles
							</a>
						</div>
					</div>
					@separator.Separator()
					<a
						href="/api/auth/logout"
						class="px-3 py-2 rounded-md text-sm font-medium text-sidebar-foreground hover:bg-destructive hover:text-white transition-colors mt-auto"
					>
						Logout
					</a>
				</aside>
				<main class="flex-1 p-8 pt-16 md:pt-8 overflow-auto">
					{ children... }
				</main>
			</div>
		</body>
	</html>
}
