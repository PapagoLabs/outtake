// Package layout renders the authenticated document shell and sidebar.
package layout

import (
	"github.com/PapagoLabs/outtake/internal/web/components/brand"
	"github.com/PapagoLabs/outtake/internal/web/components/separator"
	"github.com/PapagoLabs/outtake/internal/web/utils"
)

type Props struct {
	Title  string
	Active string
}

templ Layout(props Props) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ props.Title } - Outtake</title>
			@brand.IconHead()
			<link href="/assets/css/output.css" rel="stylesheet"/>
			<script src="/assets/js/htmx.min.js"></script>
		</head>
		<body class="min-h-screen bg-background text-foreground">
			<div class="flex min-h-screen">
				<aside class="w-64 border-r border-sidebar-border bg-sidebar p-4 flex flex-col gap-2">
					<a href="/" class="flex items-center gap-2.5 mb-4 text-sidebar-foreground">
						<img src="/assets/brand/mascot-128.png" width="32" height="32" alt="" class="size-8"/>
						<h1 class="text-xl font-bold">Outtake</h1>
					</a>
					<a
						href="/"
						class={ utils.TwMerge(
							"px-3 py-2 rounded-md text-sm font-medium transition-colors",
							utils.IfElse(props.Active == "dashboard", "bg-sidebar-primary text-sidebar-primary-foreground", "text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"),
						) }
					>
						Dashboard
					</a>
					<div class="flex flex-col gap-1">
						<a
							href="/media"
							class={ utils.TwMerge(
								"px-3 py-2 rounded-md text-sm font-medium transition-colors",
								utils.IfElse(props.Active == "media", "bg-sidebar-primary text-sidebar-primary-foreground", "text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"),
							) }
						>
							Media Libraries
						</a>
						<div id="nav-libraries" class="flex flex-col gap-1 pl-2" hx-get="/nav/libraries" hx-trigger="load" hx-swap="innerHTML"></div>
					</div>
					<a
						href="/clips"
						class={ utils.TwMerge(
							"px-3 py-2 rounded-md text-sm font-medium transition-colors",
							utils.IfElse(props.Active == "clips", "bg-sidebar-primary text-sidebar-primary-foreground", "text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"),
						) }
					>
						Clips
					</a>
					<div class="flex flex-col gap-1">
						<span class="px-3 py-2 text-sm font-medium text-sidebar-foreground">Settings</span>
						<div class="flex flex-col gap-1 pl-2">
							<a
								href="/servers"
								class={ utils.TwMerge(
									"px-3 py-1.5 rounded-md text-xs font-medium transition-colors",
									utils.IfElse(props.Active == "servers", "bg-sidebar-primary text-sidebar-primary-foreground", "text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"),
								) }
							>
								Servers
							</a>
							<a
								href="/settings/profiles"
								class={ utils.TwMerge(
									"px-3 py-1.5 rounded-md text-xs font-medium transition-colors",
									utils.IfElse(props.Active == "profiles", "bg-sidebar-primary text-sidebar-primary-foreground", "text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"),
								) }
							>
								Clip Profiles
							</a>
						</div>
					</div>
					@separator.Separator()
					<a
						href="/api/auth/logout"
						class="px-3 py-2 rounded-md text-sm font-medium text-sidebar-foreground hover:bg-destructive hover:text-white transition-colors mt-auto"
					>
						Logout
					</a>
				</aside>
				<main class="flex-1 p-8 overflow-auto">
					{ children... }
				</main>
			</div>
		</body>
	</html>
}
