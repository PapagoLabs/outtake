// Package clip renders clip cards, edit forms, and shared clip fields.
package clip

import (
	"strconv"
	"time"

	domainclip "github.com/PapagoLabs/outtake/internal/clip"
	"github.com/PapagoLabs/outtake/internal/timecode"
	"github.com/PapagoLabs/outtake/internal/web/components/badge"
	"github.com/PapagoLabs/outtake/internal/web/components/card"
	"github.com/PapagoLabs/outtake/internal/web/components/checkbox"
	"github.com/PapagoLabs/outtake/internal/web/components/csrf"
	"github.com/PapagoLabs/outtake/internal/web/components/label"
	"github.com/PapagoLabs/outtake/internal/web/components/quality"
	"github.com/PapagoLabs/outtake/internal/web/utils"
	"github.com/PapagoLabs/outtake/internal/web/view"
)

// statusBadgeVariant returns the badge variant for a clip status.
//
// Parameters:
//   - status: Clip status.
//
// Returns:
//   - variant: Badge variant for that status.
func statusBadgeVariant(status domainclip.Status) badge.Variant {
	switch status {
	case domainclip.StatusCompleted:
		return badge.VariantDefault
	case domainclip.StatusPending, domainclip.StatusProcessing:
		return badge.VariantSecondary
	case domainclip.StatusFailed:
		return badge.VariantDestructive
	case domainclip.StatusCancelled:
		return badge.VariantOutline
	default:
		return badge.VariantOutline
	}
}

// clipFileURL builds the file URL for one clip.
//
// Parameters:
//   - id: Clip id.
//
// Returns:
//   - url: The /clips file URL.
func clipFileURL(id string) templ.SafeURL {
	return templ.SafeURL("/clips/" + id + "/file")
}

// clipPlayback renders the collapsible preview for a clip that can play.
//
// Parameters:
//   - item: Clip being rendered.
templ clipPlayback(item view.ClipItem) {
	if item.CanPlay() {
		<details class="rounded-md border">
			<summary class="cursor-pointer select-none px-3 py-1.5 text-sm font-medium">Preview</summary>
			<div class="border-t p-2">
				if item.ClipType == domainclip.TypeGIF || item.ClipType == domainclip.TypeScreenshot {
					<img src={ clipFileURL(item.ID) } alt={ item.DisplayName() } loading="lazy" class="w-full max-h-64 rounded-md object-contain bg-black"/>
				} else {
					<video controls preload="none" class="w-full max-h-64 rounded-md bg-black" src={ clipFileURL(item.ID) }></video>
				}
			</div>
		</details>
	}
}

// clipFileBadge renders the badge for a clip whose output file is gone.
//
// Parameters:
//   - item: Clip being rendered.
templ clipFileBadge(item view.ClipItem) {
	if !item.IsActive() && !item.FileExists && item.Status != domainclip.StatusCancelled {
		@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
			Missing file
		}
	}
}

// ClipStatus renders the status region a clip card polls while it encodes.
//
// Parameters:
//   - item: Clip being rendered.
templ ClipStatus(item view.ClipItem) {
	<div
		id={ "clip-" + item.ID + "-status" }
		if item.IsActive() {
			hx-get={ "/clips/" + item.ID + "/row" }
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
		class="flex flex-col gap-4"
	>
		<div class="flex items-center justify-between gap-3">
			<div class="flex flex-col gap-1">
				<div class="flex flex-wrap items-center gap-2">
					<span class="font-medium">{ item.DisplayName() }</span>
					@badge.Badge(badge.Props{Variant: statusBadgeVariant(item.Status)}) {
						{ item.Status }
					}
					@clipFileBadge(item)
				</div>
				<div class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
					<span>{ view.ClipTypeLabel(item.ClipType) }</span>
					if item.MediaTitle != "" {
						<span>&middot;</span>
						if item.MediaID != "" {
							<a href={ templ.SafeURL("/media/item/" + item.MediaID) } class="hover:text-foreground">{ item.MediaTitle }</a>
						} else {
							<span>{ item.MediaTitle }</span>
						}
					}
					if item.ProfileName != "" {
						<span>&middot;</span>
						<span>{ item.ProfileName }</span>
					}
					if item.ClipType != domainclip.TypeScreenshot && item.Duration > 0 {
						<span>&middot;</span>
						<span>{ timecode.FromDuration(item.Duration).Short() }</span>
					}
					if item.CreatedAt != "" {
						<span>&middot;</span>
						<span>{ item.CreatedAt }</span>
					}
				</div>
			</div>
			<button
				type="button"
				hx-delete={ "/api/clips/" + item.ID }
				hx-target={ "#clip-" + item.ID }
				hx-swap="delete"
				hx-disable="this"
				hx-confirm="Delete this clip? This cannot be undone."
				class="inline-flex items-center justify-center rounded-md border border-destructive text-destructive px-3 py-1.5 text-xs font-medium hover:bg-destructive/10 transition-colors"
			>
				Delete
			</button>
		</div>
		if item.Error != "" {
			<p class="text-sm text-destructive">{ item.Error }</p>
		}
		if item.IsActive() {
			<div class="h-1.5 w-full overflow-hidden rounded-full bg-secondary">
				<div class="h-full rounded-full bg-primary" style={ "width: " + strconv.Itoa(item.Progress) + "%" }></div>
			</div>
			<p class="text-xs text-muted-foreground">{ strconv.Itoa(item.Progress) }%</p>
		}
		@clipPlayback(item)
		<div class="flex flex-wrap items-end gap-2">
			if item.IsActive() {
				<button
					type="button"
					hx-post={ "/api/clips/" + item.ID + "/cancel" }
					hx-target={ "#clip-" + item.ID }
					hx-swap="outerHTML"
					hx-disable="this"
					class="inline-flex items-center justify-center rounded-md border px-3 py-1.5 text-xs font-medium hover:bg-accent"
				>
					Cancel
				</button>
			} else {
				<button type="submit" name="regenerate" value="1" class="inline-flex items-center justify-center rounded-md border px-3 py-1.5 text-xs font-medium hover:bg-accent">
					Regenerate
				</button>
				<button type="submit" class="inline-flex items-center justify-center rounded-md border px-3 py-1.5 text-xs font-medium hover:bg-accent">
					Save metadata
				</button>
			}
			if item.CanPlay() {
				<a href={ templ.SafeURL("/api/clips/" + item.ID + "/download") } download class="inline-flex items-center justify-center rounded-md border px-3 py-1.5 text-xs font-medium hover:bg-accent">
					Download
				</a>
			}
		</div>
	</div>
}

// ClipCard renders one clip card and its metadata edit form.
//
// Parameters:
//   - item: Clip being rendered.
templ ClipCard(item view.ClipItem) {
	<div id={ "clip-" + item.ID }>
		@card.Card() {
			@card.Content() {
				<form action={ templ.SafeURL("/api/clips/" + item.ID + "/update") } method="POST" hx-post={ templ.SafeURL("/api/clips/" + item.ID + "/update") } hx-target={ "#clip-" + item.ID } hx-swap="outerHTML" class="flex flex-col gap-4" data-export-form data-max-dur={ strconv.FormatInt(int64(item.MaxDur/time.Second), 10) } data-media-dur={ timecode.FromDuration(item.MediaDuration).FormatSeconds() }>
					@csrf.Field()
					<input type="hidden" name="mediaId" value={ item.MediaID }/>
					@ClipStatus(item)
					<div class="grid gap-4 sm:grid-cols-2">
						<div class="flex flex-col gap-2">
							@label.Label(label.Props{For: "type-" + item.ID}) {
								Type
							}
							<select id={ "type-" + item.ID } name="clipType" class={ utils.ControlClass }>
								<option value={ string(domainclip.TypeClip) } selected?={ item.ClipType == domainclip.TypeClip }>Video clip</option>
								<option value={ string(domainclip.TypeGIF) } selected?={ item.ClipType == domainclip.TypeGIF }>GIF</option>
								<option value={ string(domainclip.TypeScreenshot) } selected?={ item.ClipType == domainclip.TypeScreenshot }>Screenshot</option>
							</select>
						</div>
						<div class="flex flex-col gap-2">
							@label.Label(label.Props{For: "name-" + item.ID}) {
								Name
							}
							<input id={ "name-" + item.ID } name="name" value={ item.DisplayName() } class={ utils.ControlClass }/>
						</div>
						<div class="flex flex-col gap-2">
							<div class="grid">
								<div class="col-start-1 row-start-1 flex items-baseline gap-2" data-export-for="clip,gif">
									@label.Label(label.Props{For: "start-" + item.ID}) {
										Start
									}
									<span data-start-time-error role="status" aria-live="polite" class="hidden text-xs text-destructive"></span>
								</div>
								<div class="col-start-1 row-start-1 flex items-baseline gap-2" data-export-for="screenshot">
									@label.Label(label.Props{For: "start-" + item.ID}) {
										Time
									}
									<span data-start-time-error role="status" aria-live="polite" class="hidden text-xs text-destructive"></span>
								</div>
							</div>
							<input id={ "start-" + item.ID } name="startTime" type="text" inputmode="decimal" value={ timecode.FromDuration(item.StartTime).String() } class={ utils.ControlClass }/>
						</div>
						<div class="flex flex-col gap-2" data-export-for="clip,gif">
							<div class="flex items-baseline gap-2">
								@label.Label(label.Props{For: "end-" + item.ID}) {
									End
								}
								<span data-end-time-error role="status" aria-live="polite" class="hidden text-xs text-destructive"></span>
							</div>
							<input id={ "end-" + item.ID } name="endTime" type="text" inputmode="decimal" value={ timecode.FromDuration(item.EndTime()).String() } class={ utils.ControlClass }/>
						</div>
						<input type="hidden" id={ "dur-" + item.ID } name="duration" value={ timecode.FromDuration(item.Duration).String() }/>
						<div class="flex min-w-40 flex-col gap-2" data-export-for="clip">
							@label.Label(label.Props{For: "quality-" + item.ID}) {
								Profile
							}
							@quality.QualitySelect("quality-"+item.ID, item.Profiles, item.Quality)
						</div>
						if len(item.AudioTracks) > 0 {
							<div class="flex flex-col gap-2" data-export-for="clip">
								@label.Label(label.Props{For: "audio-" + item.ID}) {
									Audio track
								}
								@quality.AudioSelect("audio-"+item.ID, item.AudioTracks, item.AudioIndex)
							</div>
						} else {
							// Without probed tracks there is no select, so the stored track is posted back unchanged.
							<input type="hidden" name="audioIndex" value={ strconv.Itoa(item.AudioIndex) }/>
						}
						<div class="flex flex-col gap-2" data-export-for="gif">
							@label.Label(label.Props{For: "width-" + item.ID}) {
								GIF width (px)
							}
							// These bounds mirror the server-side GIF width limits, which change for their own reasons.
							<input id={ "width-" + item.ID } name="width" type="number" min="120" max="1920" value={ strconv.Itoa(item.GIFWidth()) } class={ utils.ControlClass }/>
						</div>
						<div class="flex flex-col gap-2" data-export-for="gif">
							@label.Label(label.Props{For: "fps-" + item.ID}) {
								GIF frames per second
							}
							// These bounds mirror the server-side GIF frame rate limits.
							<input id={ "fps-" + item.ID } name="fps" type="number" min="5" max="30" value={ strconv.Itoa(item.GIFFPS()) } class={ utils.ControlClass }/>
						</div>
					</div>
					<p class="text-sm text-muted-foreground" data-export-for="clip,gif">Duration: <span data-duration-label>{ timecode.FromDuration(item.Duration).Short() }</span> (max { timecode.FromDuration(item.MaxDur).Short() }) <span data-duration-warning role="status" aria-live="polite" class="sr-only"></span></p>
					@ColorFields(item.CropBlackBars, item.WebSafeColor, item.PreserveHDR, item.SourceHDR)
					if !item.SourceHDR && item.PreserveHDR {
						// The HDR box only shows for an HDR source, so the stored setting is posted back unchanged.
						<input type="hidden" name="preserveHdr" value="1"/>
					}
				</form>
			}
		}
	</div>
}

// ColorFields renders the export checkboxes that apply to every clip type.
//
// Parameters:
//   - cropBlackBars: Trim black bars is checked.
//   - webSafeColor: Tone-map to web-safe color is checked.
//   - preserveHDR: Keep the source HDR transfer is checked.
//   - sourceHDR: The source carries an HDR transfer.
templ ColorFields(cropBlackBars, webSafeColor, preserveHDR, sourceHDR bool) {
	<div class="flex flex-wrap items-center gap-4">
		@CropBlackBarsField(cropBlackBars)
		@WebSafeColorField(webSafeColor)
		if sourceHDR {
			@PreserveHDRField(preserveHDR)
		}
	</div>
}

// CropBlackBarsField renders the trim-black-bars checkbox.
//
// Parameters:
//   - checked: The checkbox is checked.
templ CropBlackBarsField(checked bool) {
	<label class="flex items-center gap-2 text-sm">
		@checkbox.Checkbox(checkbox.Props{Name: "cropBlackBars", Value: "1", Checked: checked, Class: "rounded border-input"})
		Trim black bars
	</label>
}

// PreserveHDRField renders the keep-HDR checkbox.
//
// Parameters:
//   - checked: The checkbox is checked.
templ PreserveHDRField(checked bool) {
	<label class="flex items-center gap-2 text-sm" data-export-for="clip">
		@checkbox.Checkbox(checkbox.Props{Name: "preserveHdr", Value: "1", Checked: checked, Class: "rounded border-input"})
		HDR
	</label>
}

// WebSafeColorField renders the web-safe color checkbox.
//
// Parameters:
//   - checked: The checkbox is checked.
templ WebSafeColorField(checked bool) {
	<label class="flex items-center gap-2 text-sm" data-export-for="clip">
		@checkbox.Checkbox(checkbox.Props{Name: "webSafeColor", Value: "1", Checked: checked, Class: "rounded border-input"})
		Web-safe color
	</label>
}
