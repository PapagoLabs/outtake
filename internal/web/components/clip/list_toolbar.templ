package clip

import (
	domainclip "github.com/PapagoLabs/outtake/internal/clip"
	"github.com/PapagoLabs/outtake/internal/web/components/input"
	"github.com/PapagoLabs/outtake/internal/web/components/label"
	"github.com/PapagoLabs/outtake/internal/web/utils"
	"github.com/PapagoLabs/outtake/internal/web/view"
)

// ListToolbarProps carries the clip list filter and sort state.
type ListToolbarProps struct {
	Action  string
	Target  string
	PushURL bool
	Status  domainclip.Status
	Type    domainclip.Type
	Query   string
	Sort    string
}

// ListToolbar renders the clip list filter and sort form.
//
// Parameters:
//   - props: Request endpoint, swap target, and active filter and sort values.
templ ListToolbar(props ListToolbarProps) {
	<form
		hx-get={ props.Action }
		hx-target={ "#" + props.Target }
		hx-swap="innerHTML"
		hx-trigger="change from:select, submit"
		if props.PushURL {
			hx-push-url="true"
		}
		class="flex flex-wrap items-end gap-3"
	>
		if props.Status != "" {
			<input type="hidden" name="status" value={ string(props.Status) }/>
		}
		<div class="w-40">
			@label.Label(label.Props{For: "clip-list-type"}) {
				Type
			}
			<select id="clip-list-type" name="type" class={ utils.ControlClass }>
				<option value="" selected?={ props.Type == "" }>All</option>
				<option value={ string(domainclip.TypeClip) } selected?={ props.Type == domainclip.TypeClip }>Video Clip</option>
				<option value={ string(domainclip.TypeGIF) } selected?={ props.Type == domainclip.TypeGIF }>GIF</option>
				<option value={ string(domainclip.TypeScreenshot) } selected?={ props.Type == domainclip.TypeScreenshot }>Screenshot</option>
			</select>
		</div>
		<div class="min-w-48 flex-1">
			@label.Label(label.Props{For: "clip-list-q", Class: "sr-only"}) {
				Filter by Name
			}
			@input.Input(input.Props{ID: "clip-list-q", Name: "q", Type: input.TypeSearch, Placeholder: "Filter by name", Value: props.Query})
		</div>
		<div class="w-52">
			@label.Label(label.Props{For: "clip-list-sort"}) {
				Sort
			}
			<select id="clip-list-sort" name="sort" class={ utils.ControlClass }>
				<option value={ view.ClipSortCreatedDesc } selected?={ view.SortSelected(props.Sort, view.ClipSortCreatedDesc, view.ClipSortCreatedDesc) }>Created (Newest)</option>
				<option value={ view.ClipSortCreatedAsc } selected?={ view.SortSelected(props.Sort, view.ClipSortCreatedAsc, view.ClipSortCreatedDesc) }>Created (Oldest)</option>
				<option value={ view.ClipSortUpdatedDesc } selected?={ view.SortSelected(props.Sort, view.ClipSortUpdatedDesc, view.ClipSortCreatedDesc) }>Modified (Newest)</option>
				<option value={ view.ClipSortUpdatedAsc } selected?={ view.SortSelected(props.Sort, view.ClipSortUpdatedAsc, view.ClipSortCreatedDesc) }>Modified (Oldest)</option>
				<option value={ view.ClipSortNameAsc } selected?={ view.SortSelected(props.Sort, view.ClipSortNameAsc, view.ClipSortCreatedDesc) }>Name (A–Z)</option>
				<option value={ view.ClipSortNameDesc } selected?={ view.SortSelected(props.Sort, view.ClipSortNameDesc, view.ClipSortCreatedDesc) }>Name (Z–A)</option>
			</select>
		</div>
		<button type="submit" class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-4 py-2 text-sm font-medium hover:bg-primary/90 transition-colors">
			Filter
		</button>
	</form>
}
