// Package quality renders clip profile and audio track selects.
package quality

import (
	viewclip "github.com/PapagoLabs/outtake/internal/web/view/clip"
	"strconv"

)

func qualityOptionSelected(profile viewclip.ClipProfileOption, selected string) bool {
	if selected == "" {
		return profile.IsDefault
	}

	return profile.ID == selected
}

templ AudioSelect(id string, tracks []viewclip.AudioTrackOption, selected int) {
	if len(tracks) == 0 {
		<input type="hidden" name="audioIndex" value={ strconv.Itoa(selected) }/>
	} else {
		<select id={ id } name="audioIndex" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm dark:bg-input/30">
			for _, track := range tracks {
				if track.Index == selected {
					<option value={ strconv.Itoa(track.Index) } selected>{ track.Label }</option>
				} else {
					<option value={ strconv.Itoa(track.Index) }>{ track.Label }</option>
				}
			}
		</select>
	}
}

templ QualitySelect(id string, profiles []viewclip.ClipProfileOption, selected string) {
	<select id={ id } name="quality" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm dark:bg-input/30">
		for _, profile := range profiles {
			if qualityOptionSelected(profile, selected) {
				<option value={ profile.ID } selected>{ profile.Name }</option>
			} else {
				<option value={ profile.ID }>{ profile.Name }</option>
			}
		}
	</select>
}
