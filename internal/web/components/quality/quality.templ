// Package quality renders clip profile and audio track selects.
package quality

import (
	"strconv"

	"github.com/PapagoLabs/outtake/internal/clip/profile"
	"github.com/PapagoLabs/outtake/internal/web/utils"
	"github.com/PapagoLabs/outtake/internal/web/view"
)

// qualityOptionSelected reports whether a profile option is the current choice.
//
// Parameters:
//   - profile: Profile option being rendered.
//   - selected: Chosen profile id, empty when the form was never submitted.
//
// Returns:
//   - ok: True when the option is the current choice.
func qualityOptionSelected(profile profile.ProfileOption, selected string) bool {
	if selected == "" {
		return profile.IsDefault
	}

	return profile.ID == selected
}

// AudioSelect renders the audio track select, or a hidden input when there are no tracks.
//
// Parameters:
//   - id: Select id.
//   - tracks: Audio tracks to choose from.
//   - selected: Index of the chosen track.
templ AudioSelect(id string, tracks []view.AudioTrackOption, selected int) {
	if len(tracks) == 0 {
		<input type="hidden" name="audioIndex" value={ strconv.Itoa(selected) }/>
	} else {
		<select id={ id } name="audioIndex" class={ utils.ControlClass }>
			for _, track := range tracks {
				if track.Index == selected {
					<option value={ strconv.Itoa(track.Index) } selected>{ track.Label }</option>
				} else {
					<option value={ strconv.Itoa(track.Index) }>{ track.Label }</option>
				}
			}
		</select>
	}
}

// keepHDRAttr renders a profile's keep-HDR default for the export form script,
// which sets the Keep HDR checkbox from the chosen profile.
//
// Parameters:
//   - profile: The offered profile.
//
// Returns:
//   - value: "1" when the profile keeps HDR, otherwise "0".
func keepHDRAttr(profile profile.ProfileOption) string {
	if profile.KeepHDR {
		return "1"
	}

	return "0"
}

// QualitySelect renders the clip profile select.
//
// Parameters:
//   - id: Select id.
//   - profiles: Clip profiles to choose from.
//   - selected: Chosen profile id, empty when the form was never submitted.
templ QualitySelect(id string, profiles []profile.ProfileOption, selected string) {
	<select id={ id } name="quality" class={ utils.ControlClass }>
		for _, profile := range profiles {
			if qualityOptionSelected(profile, selected) {
				<option value={ profile.ID } data-keep-hdr={ keepHDRAttr(profile) } selected>{ profile.Name }</option>
			} else {
				<option value={ profile.ID } data-keep-hdr={ keepHDRAttr(profile) }>{ profile.Name }</option>
			}
		}
	</select>
}
