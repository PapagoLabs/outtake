// Package browse renders the media library grid and breadcrumbs.
package browse

import (
	"net/url"
	"strconv"
	"time"

	"github.com/PapagoLabs/outtake/internal/timecode"
	"github.com/PapagoLabs/outtake/internal/web/components/aspectratio"
	"github.com/PapagoLabs/outtake/internal/web/components/card"
	"github.com/PapagoLabs/outtake/internal/web/components/label"
	"github.com/PapagoLabs/outtake/internal/web/utils"
	"github.com/PapagoLabs/outtake/internal/web/view"
)

// thumbAspect returns the poster aspect-ratio wrapper for a media card.
//
// Parameters:
//   - mediaType: Plex media type of the card being rendered.
//
// Returns:
//   - props: AspectRatio properties for the poster wrapper.
func thumbAspect(mediaType string) aspectratio.Props {
	switch mediaType {
	case "episode", "track":
		return aspectratio.Props{Ratio: aspectratio.RatioVideo}
	case "artist", "album":
		return aspectratio.Props{Ratio: aspectratio.RatioSquare}
	default:
		return aspectratio.Props{Ratio: aspectratio.RatioAuto, Class: "aspect-[2/3]"}
	}
}

// emptyMediaMessage returns the message shown when a browse returns nothing.
//
// Parameters:
//   - props: Media library page state.
//
// Returns:
//   - message: Why the browse is empty.
func emptyMediaMessage(props view.MediaProps) string {
	if !props.HasServer {
		return "No media found. Connect your Plex server and try again."
	}

	if props.Query != "" {
		return `No titles matched "` + props.Query + `".`
	}

	return "This folder is empty."
}

// showSort reports whether the library root should show the sort control.
//
// Parameters:
//   - props: Media library page state.
//
// Returns:
//   - ok: True when a library is selected without a parent or search.
func showSort(props view.MediaProps) bool {
	return props.LibraryID != "" && props.ParentID == "" && props.Query == ""
}

// showLetters reports whether the jump rail should render.
//
// Parameters:
//   - props: Media library page state.
//
// Returns:
//   - ok: True when sort is shown and letter buckets exist.
func showLetters(props view.MediaProps) bool {
	return showSort(props) && len(props.Letters) > 0
}

// jumpRailKind is what a jump rail's marks hold.
type jumpRailKind string

// The kinds of mark a jump rail can hold.
const (
	jumpKindLetter jumpRailKind = "letter"
	jumpKindYear   jumpRailKind = "year"
	jumpKindMonth  jumpRailKind = "month"
)

// jumpRail is how one sort's jump rail reads: its accessible name, its width, and its marks.
type jumpRail struct {
	label string
	width string
	kind  jumpRailKind
}

// One rail per jump-mark kind, widest for a month mark and narrowest for a letter mark.
var (
	letterRail = jumpRail{label: "Jump to letter", width: "w-8", kind: jumpKindLetter}
	yearRail   = jumpRail{label: "Jump to year", width: "w-10", kind: jumpKindYear}
	monthRail  = jumpRail{label: "Jump to month", width: "w-14", kind: jumpKindMonth}
)

// jumpRailFor returns the jump rail for a sort.
//
// Parameters:
//   - sort: Normalized Outtake sort key.
//
// Returns:
//   - rail: Year or month rail, falling back to letters for title sorts.
func jumpRailFor(sort string) jumpRail {
	switch sort {
	case view.MediaSortYearAsc, view.MediaSortYearDesc:
		return yearRail
	case view.MediaSortAddedAsc, view.MediaSortAddedDesc:
		return monthRail
	default:
		return letterRail
	}
}

// jumpKey returns the poster data-jump value for the active sort.
//
// Parameters:
//   - item: Media card being rendered.
//   - sort: Normalized Outtake sort key.
//
// Returns:
//   - key: Letter, year, month, or the other-key mark.
func jumpKey(item view.MediaItem, sort string) string {
	switch jumpRailFor(sort).kind {
	case jumpKindYear:
		if item.Year <= 0 {
			return view.JumpOtherKey
		}

		return strconv.Itoa(item.Year)
	case jumpKindMonth:
		if item.AddedAt <= 0 {
			return view.JumpOtherKey
		}

		return time.Unix(item.AddedAt, 0).Local().Format("01/2006")
	default:
		return view.TitleJumpKey(item.TitleSort, item.Title)
	}
}

// hasPrev reports whether a previous poster page can be prepended.
//
// Parameters:
//   - props: Media library page state.
//
// Returns:
//   - ok: True when start is past the first page and search is empty.
func hasPrev(props view.MediaProps) bool {
	return props.Query == "" && props.Start > 0
}

// showChooser reports whether the page should offer the library chooser.
//
// Parameters:
//   - props: Media library page state.
//
// Returns:
//   - ok: True when no library is selected and there is nothing to show.
func showChooser(props view.MediaProps) bool {
	return props.LibraryID == "" && len(props.Libraries) > 0 && len(props.Items) == 0 && props.Query == ""
}

// hasMore reports whether a following poster page exists.
//
// Parameters:
//   - props: Media library page state.
//
// Returns:
//   - ok: True when the items shown do not reach the total.
func hasMore(props view.MediaProps) bool {
	return props.Query == "" && props.PageSize > 0 && props.Start+len(props.Items) < props.Total
}

// browseValues builds shared query parameters for media browse URLs.
//
// Parameters:
//   - props: Media library page state.
//
// Returns:
//   - values: Library, parent, crumb, and sort parameters.
func browseValues(props view.MediaProps) url.Values {
	values := url.Values{}
	if props.LibraryID != "" {
		values.Set("library", props.LibraryID)
	}

	if props.ParentID != "" {
		values.Set("parent", props.ParentID)
	}

	if props.ParentTitle != "" {
		values.Set("title", props.ParentTitle)
	}

	if props.UpID != "" {
		values.Set("up", props.UpID)
	}

	if props.UpTitle != "" {
		values.Set("upTitle", props.UpTitle)
	}

	if props.Sort != "" {
		values.Set("sort", props.Sort)
	}

	return values
}

// encodeMediaURL builds a /media URL from query values.
//
// Parameters:
//   - values: Query parameters to encode.
//
// Returns:
//   - url: /media, with a query string when values are set.
func encodeMediaURL(values url.Values) string {
	encoded := values.Encode()
	if encoded == "" {
		return "/media"
	}

	return "/media?" + encoded
}

// nextPageURL builds the infinite-scroll URL for the next poster page.
//
// Parameters:
//   - props: Media library page state.
//
// Returns:
//   - url: /media URL with start set past the current items.
func nextPageURL(props view.MediaProps) string {
	values := browseValues(props)
	start := props.Start + len(props.Items)
	if start > 0 {
		values.Set("start", strconv.Itoa(start))
	}

	return encodeMediaURL(values)
}

// prevPageURL builds the infinite-scroll URL for the previous poster page.
//
// Parameters:
//   - props: Media library page state.
//
// Returns:
//   - url: /media URL with before set to the current start.
func prevPageURL(props view.MediaProps) string {
	values := browseValues(props)
	if props.Start > 0 {
		values.Set("before", strconv.Itoa(props.Start))
	}

	return encodeMediaURL(values)
}

// letterURL builds a library-root jump URL for one rail mark.
//
// Parameters:
//   - props: Media library page state.
//   - letter: Jump title to select.
//
// Returns:
//   - url: /media URL with library, sort, and letter.
func letterURL(props view.MediaProps, letter string) string {
	values := url.Values{}
	if props.LibraryID != "" {
		values.Set("library", props.LibraryID)
	}

	if props.Sort != "" {
		values.Set("sort", props.Sort)
	}

	if letter != "" {
		values.Set("letter", letter)
	}

	return encodeMediaURL(values)
}

// libraryURL builds the media listing link for one library.
//
// Parameters:
//   - id: The Plex library id.
//
// Returns:
//   - href: The /media link for that library.
func libraryURL(id string) templ.SafeURL {
	values := url.Values{}
	values.Set("library", id)

	return templ.SafeURL("/media?" + values.Encode())
}

// itemURL returns the poster destination for a media card.
//
// Parameters:
//   - item: Media card being rendered.
//
// Returns:
//   - url: Browse URL for containers, or the item editor otherwise.
func itemURL(item view.MediaItem) templ.SafeURL {
	if item.Browsable {
		return templ.SafeURL(item.BrowseURL)
	}

	return templ.SafeURL("/media/item/" + item.ID)
}

// libraryInitial returns the first rune of a library title.
//
// Parameters:
//   - title: Library display name.
//
// Returns:
//   - initial: First character, or # when title is empty.
func libraryInitial(title string) string {
	for _, r := range title {
		return string(r)
	}

	return "#"
}

// mediaCard renders one poster in the media grid.
//
// Parameters:
//   - item: Media card being rendered.
//   - sort: Normalized Outtake sort key used for the jump marker.
templ mediaCard(item view.MediaItem, sort string) {
	@card.Card(card.Props{Attributes: templ.Attributes{"data-jump": jumpKey(item, sort)}}) {
		@card.Content(card.ContentProps{Class: "p-3"}) {
			<div class="flex flex-col gap-2">
				<a href={ itemURL(item) } class="block rounded-md focus-visible:ring-2 focus-visible:ring-ring/50 focus-visible:outline-none">
					if item.ThumbPath != "" {
						@aspectratio.AspectRatio(thumbAspect(item.Type)) {
							<img src={ item.ThumbPath } alt={ item.Title } class="size-full rounded-md object-cover bg-muted transition-opacity hover:opacity-90"/>
						}
					} else {
						@aspectratio.AspectRatio(thumbAspect(item.Type)) {
							<div class="flex size-full items-center justify-center rounded-md bg-muted transition-opacity hover:opacity-90">
								<span class="text-muted-foreground text-sm">No thumbnail</span>
							</div>
						}
					}
				</a>
				<h3 class="font-medium text-sm line-clamp-1">
					<a href={ itemURL(item) } class="hover:underline">{ item.Title }</a>
				</h3>
				<div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
					<span class="capitalize">{ item.Type }</span>
					if item.ShowTitle != "" {
						<span>&middot;</span>
						<span class="line-clamp-1">{ item.ShowTitle }</span>
					}
					if item.EpisodeLabel != "" {
						<span>&middot;</span>
						<span>{ item.EpisodeLabel }</span>
					}
					if item.Year > 0 {
						<span>&middot;</span>
						<span>{ strconv.Itoa(item.Year) }</span>
					}
					if item.Duration > 0 && item.Type != "show" && item.Type != "season" && item.Type != "artist" {
						<span>&middot;</span>
						<span>{ timecode.FromDuration(item.Duration).Short() }</span>
					}
				</div>
			</div>
		}
	}
}

// libraryCard renders a library chooser row.
//
// Parameters:
//   - lib: Library to link.
templ libraryCard(lib view.LibraryItem) {
	<a
		href={ libraryURL(lib.ID) }
		class="flex items-center gap-4 self-start rounded-lg border bg-card p-4 text-card-foreground shadow-xs transition-colors hover:bg-accent/40 focus-visible:ring-2 focus-visible:ring-ring/50 focus-visible:outline-none"
	>
		if lib.ThumbPath != "" {
			<img src={ lib.ThumbPath } alt="" class="size-16 shrink-0 rounded-md object-cover bg-muted"/>
		} else {
			<div class="flex size-16 shrink-0 items-center justify-center rounded-md bg-muted text-lg font-semibold text-muted-foreground">
				{ libraryInitial(lib.Title) }
			</div>
		}
		<div class="min-w-0">
			<h3 class="font-medium truncate">{ lib.Title }</h3>
			<p class="text-xs text-muted-foreground capitalize">{ lib.Type }</p>
		</div>
	</a>
}

// mediaCrumbs renders the breadcrumb trail for the current location.
//
// Parameters:
//   - crumbs: Breadcrumb trail, last entry being the current location.
templ mediaCrumbs(crumbs []view.Crumb) {
	if len(crumbs) > 0 {
		<nav class="col-span-full flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
			for i, crumb := range crumbs {
				if i > 0 {
					<span>/</span>
				}
				if crumb.URL != "" {
					<a href={ templ.SafeURL(crumb.URL) } class="hover:text-foreground">{ crumb.Title }</a>
				} else {
					<span class="text-foreground">{ crumb.Title }</span>
				}
			}
		</nav>
	}
}

// mediaSortToolbar renders the library-root sort control.
//
// Parameters:
//   - props: Media library page state.
templ mediaSortToolbar(props view.MediaProps) {
	<form class="w-52">
		<input type="hidden" name="library" value={ props.LibraryID }/>
		<div class="w-52">
			@label.Label(label.Props{For: "media-list-sort"}) {
				Sort
			}
			<select
				id="media-list-sort"
				name="sort"
				hx-get="/media"
				hx-target="#media-browse"
				hx-swap="innerHTML"
				hx-push-url="true"
				hx-include="closest form"
				class={ utils.ControlClass }
			>
				<option value={ view.MediaSortTitleAsc } selected?={ view.SortSelected(props.Sort, view.MediaSortTitleAsc, view.MediaSortTitleAsc) }>Title A-Z</option>
				<option value={ view.MediaSortTitleDesc } selected?={ view.SortSelected(props.Sort, view.MediaSortTitleDesc, view.MediaSortTitleAsc) }>Title Z-A</option>
				<option value={ view.MediaSortYearDesc } selected?={ view.SortSelected(props.Sort, view.MediaSortYearDesc, view.MediaSortTitleAsc) }>Year newest</option>
				<option value={ view.MediaSortYearAsc } selected?={ view.SortSelected(props.Sort, view.MediaSortYearAsc, view.MediaSortTitleAsc) }>Year oldest</option>
				<option value={ view.MediaSortAddedDesc } selected?={ view.SortSelected(props.Sort, view.MediaSortAddedDesc, view.MediaSortTitleAsc) }>Date added newest</option>
				<option value={ view.MediaSortAddedAsc } selected?={ view.SortSelected(props.Sort, view.MediaSortAddedAsc, view.MediaSortTitleAsc) }>Date added oldest</option>
			</select>
		</div>
	</form>
}

// letterJumpSelect renders the small-screen jump dropdown.
//
// Parameters:
//   - props: Media library page state.
templ letterJumpSelect(props view.MediaProps) {
	<form class="w-36 md:hidden">
		<input type="hidden" name="library" value={ props.LibraryID }/>
		if props.Sort != "" {
			<input type="hidden" name="sort" value={ props.Sort }/>
		}
		@label.Label(label.Props{For: "media-list-letter"}) {
			Jump to
		}
		<select
			id="media-list-letter"
			name="letter"
			hx-get="/media"
			hx-target="#media-browse"
			hx-swap="innerHTML"
			hx-push-url="true"
			hx-include="closest form"
			class={ utils.ControlClass }
		>
			<option value="" selected?={ props.Letter == "" }>Jump</option>
			for _, letter := range props.Letters {
				<option value={ letter.Title } selected?={ props.Letter == letter.Title }>{ letter.Title }</option>
			}
		</select>
	</form>
}

// letterLinks renders desktop jump-rail marks.
//
// Parameters:
//   - props: Media library page state.
templ letterLinks(props view.MediaProps) {
	for _, letter := range props.Letters {
		<a
			href={ templ.SafeURL(letterURL(props, letter.Title)) }
			hx-get={ letterURL(props, letter.Title) }
			hx-target="#media-browse"
			hx-swap="innerHTML"
			hx-push-url="true"
			data-jump-key={ letter.Title }
			class={ utils.TwMerge(
				"js-media-jump inline-flex min-h-5 w-full flex-1 items-center justify-center rounded px-0 text-xs font-medium leading-none hover:bg-accent",
				utils.IfElse(props.Letter == letter.Title, "bg-primary text-primary-foreground", "text-muted-foreground"),
			) }
		>{ letter.Title }</a>
	}
}

// mediaMoreSentinel renders the infinite-scroll sentinel for the next page.
//
// Parameters:
//   - props: Media library page state.
templ mediaMoreSentinel(props view.MediaProps) {
	if hasMore(props) {
		<div
			id="media-more"
			hx-get={ nextPageURL(props) }
			hx-trigger="revealed"
			hx-swap="outerHTML"
			class="col-span-full py-4 text-center text-sm text-muted-foreground"
		>
			Loading more…
		</div>
	}
}

// mediaPrevSentinel renders the infinite-scroll sentinel for the previous page.
//
// Parameters:
//   - props: Media library page state.
templ mediaPrevSentinel(props view.MediaProps) {
	if hasPrev(props) {
		<div
			id="media-prev"
			hx-get={ prevPageURL(props) }
			hx-trigger="intersect delay:300ms root:#media-results"
			hx-swap="outerHTML"
			class="col-span-full py-4 text-center text-sm text-muted-foreground"
		>
			Loading previous…
		</div>
	}
}

// MediaBrowse renders the media library browse pane.
//
// Parameters:
//   - props: Media library page state.
templ MediaBrowse(props view.MediaProps) {
	<div class="flex h-full min-h-0 flex-col gap-4">
		if showSort(props) {
			<div class="flex shrink-0 flex-wrap items-end gap-3">
				@mediaSortToolbar(props)
				if showLetters(props) {
					@letterJumpSelect(props)
				}
			</div>
		}
		<div class="flex min-h-0 flex-1 gap-5">
			<div id="media-results" class="grid min-h-0 min-w-0 flex-1 content-start gap-4 overflow-y-auto overscroll-contain pr-4 grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
				@MediaResults(props)
			</div>
			if showLetters(props) {
				<nav class={ "hidden h-full min-h-0 shrink-0 flex-col overflow-y-auto overscroll-contain md:flex " + jumpRailFor(props.Sort).width } aria-label={ jumpRailFor(props.Sort).label } data-jump-nav data-jump-kind={ string(jumpRailFor(props.Sort).kind) }>
					@letterLinks(props)
				</nav>
			}
		</div>
	</div>
}

// MediaResults renders the chooser, the empty message, and one page of results.
//
// Parameters:
//   - props: Media library page state.
templ MediaResults(props view.MediaProps) {
	if showChooser(props) {
		<div class="col-span-full flex flex-col gap-3">
			@mediaCrumbs(props.Crumbs)
			<div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
				for _, lib := range props.Libraries {
					@libraryCard(lib)
				}
			</div>
		</div>
	} else {
		@mediaCrumbs(props.Crumbs)
		if len(props.Items) == 0 && (props.Query != "" || props.LibraryID != "" || len(props.Libraries) == 0) {
			<div class="col-span-full text-center py-12 text-muted-foreground">
				<p>{ emptyMediaMessage(props) }</p>
			</div>
		}
		@mediaPrevSentinel(props)
		for _, item := range props.Items {
			@mediaCard(item, props.Sort)
		}
		@mediaMoreSentinel(props)
	}
}

// MediaMore renders the next poster page for infinite scroll.
//
// Parameters:
//   - props: Media library page state.
templ MediaMore(props view.MediaProps) {
	for _, item := range props.Items {
		@mediaCard(item, props.Sort)
	}
	@mediaMoreSentinel(props)
}

// MediaPrev renders the previous poster page for infinite scroll.
//
// Parameters:
//   - props: Media library page state.
templ MediaPrev(props view.MediaProps) {
	@mediaPrevSentinel(props)
	for _, item := range props.Items {
		@mediaCard(item, props.Sort)
	}
}
