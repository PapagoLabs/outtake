// Package nav renders sidebar library links.
package nav

import (
	"github.com/PapagoLabs/outtake/internal/web/utils"
	"github.com/PapagoLabs/outtake/internal/web/view"
)

templ NavLibraries(libs []view.LibraryItem, selected string) {
	for _, lib := range libs {
		<a
			href={ templ.SafeURL("/media?library=" + lib.ID) }
			data-nav-library={ lib.ID }
			hx-target="#main-content"
			hx-select="#main-content"
			hx-swap="outerHTML scroll:window:top"
			class={ utils.TwMerge(
				"px-3 py-1.5 rounded-md text-xs font-medium transition-colors",
				utils.IfElse(lib.ID == selected, "bg-sidebar-primary text-sidebar-primary-foreground", "text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"),
			) }
		>
			{ lib.Title }
		</a>
	}
}
