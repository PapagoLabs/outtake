// Package playback renders the live Plex position panel.
package playback

import (
	"github.com/PapagoLabs/outtake/internal/timecode"
	"github.com/PapagoLabs/outtake/internal/web/view"
)

// PlaybackPanel renders the live Plex position and its mark controls. The
// buttons carry the position shown, and read it fresh from Plex when clicked.
//
// Parameters:
//   - props: Current Plex playback state.
templ PlaybackPanel(props view.Playback) {
	<div>
		if props.Playing {
			if props.Paused {
				<p class="text-sm">Plex is paused at <span class="font-medium">{ timecode.FromDuration(props.ViewOffset).String() }</span></p>
			} else {
				<p class="text-sm">Plex is playing at <span class="font-medium">{ timecode.FromDuration(props.ViewOffset).String() }</span></p>
				<p class="text-xs text-muted-foreground mt-1">Pause in Plex for an exact position</p>
			}
			<div class="flex flex-wrap gap-2 mt-3">
				<button type="button" class="js-mark-start inline-flex items-center rounded-md border px-3 py-1.5 text-xs font-medium hover:bg-accent" data-offset={ timecode.FromDuration(props.ViewOffset).FormatSeconds() } data-position-url={ props.PositionURL }>Set Start From Plex</button>
				<button type="button" class="js-mark-end inline-flex items-center rounded-md border px-3 py-1.5 text-xs font-medium hover:bg-accent" data-offset={ timecode.FromDuration(props.ViewOffset).FormatSeconds() } data-position-url={ props.PositionURL }>Set End From Plex</button>
			</div>
		} else {
			<p class="text-sm text-muted-foreground">Play this title in Plex to set the start and end from its position</p>
		}
	</div>
}
