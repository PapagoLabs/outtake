package pages

import (
	"strconv"

	"github.com/PapagoLabs/outtake/internal/timecode"
	"github.com/PapagoLabs/outtake/internal/web/components/card"
	"github.com/PapagoLabs/outtake/internal/web/components/layout"
	"github.com/PapagoLabs/outtake/internal/web/view"
)

// DashboardProps carries the clip counts and live sessions.
type DashboardProps struct {
	TotalClips   int
	PendingClips int
	Completed    int
	Failed       int
	Sessions     []view.SessionItem
	// TokenRejected reports that the bound server refuses its stored token.
	TokenRejected bool
}

// Dashboard renders the activity overview page.
//
// Parameters:
//   - props: Clip counts and live sessions.
templ Dashboard(props DashboardProps) {
	@layout.Layout(layout.Props{Title: "Dashboard", Active: "dashboard"}) {
		<div class="flex flex-col gap-6">
			<div>
				<h2 class="text-2xl font-bold tracking-tight">Dashboard</h2>
				<p class="text-muted-foreground">Overview of your media clipping activity.</p>
			</div>
			<div class="grid gap-4 md:grid-cols-4">
				<a href="/clips" class="block">
					@card.Card() {
						@card.Content() {
							<div class="flex flex-col gap-1">
								<p class="text-sm text-muted-foreground">Total Clips</p>
								<p class="text-3xl font-bold">{ strconv.Itoa(props.TotalClips) }</p>
							</div>
						}
					}
				</a>
				<a href="/clips?status=pending" class="block">
					@card.Card() {
						@card.Content() {
							<div class="flex flex-col gap-1">
								<p class="text-sm text-muted-foreground">Pending</p>
								<p class="text-3xl font-bold text-yellow-500">{ strconv.Itoa(props.PendingClips) }</p>
							</div>
						}
					}
				</a>
				<a href="/clips?status=completed" class="block">
					@card.Card() {
						@card.Content() {
							<div class="flex flex-col gap-1">
								<p class="text-sm text-muted-foreground">Completed</p>
								<p class="text-3xl font-bold text-green-500">{ strconv.Itoa(props.Completed) }</p>
							</div>
						}
					}
				</a>
				<a href="/clips?status=failed" class="block">
					@card.Card() {
						@card.Content() {
							<div class="flex flex-col gap-1">
								<p class="text-sm text-muted-foreground">Failed</p>
								<p class="text-3xl font-bold text-destructive">{ strconv.Itoa(props.Failed) }</p>
							</div>
						}
					}
				</a>
			</div>
			@LiveSessions(props.Sessions, props.TokenRejected)
			<div class="flex gap-4">
				<a href="/media" class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-4 py-2 text-sm font-medium hover:bg-primary/90 transition-colors">
					Browse Media
				</a>
				<a href="/clips" class="inline-flex items-center justify-center rounded-md border px-4 py-2 text-sm font-medium hover:bg-accent transition-colors">
					View Clips
				</a>
			</div>
		</div>
	}
}

// LiveSessions renders the polling panel of live Plex playback sessions.
//
// Parameters:
//   - sessions: Sessions playing right now.
//   - tokenRejected: The bound server refuses its stored token, so no
//     sessions can be read.
templ LiveSessions(sessions []view.SessionItem, tokenRejected bool) {
	<div id="live-sessions" class="flex flex-col gap-3" hx-get="/dashboard/sessions" hx-trigger="every 10s" hx-swap="outerHTML">
		<h3 class="text-lg font-semibold">Live Sessions</h3>
		if tokenRejected {
			@TokenRejectedNotice()
		}
		if len(sessions) == 0 {
			<p class="text-sm text-muted-foreground">No one is playing anything in Plex right now.</p>
		}
		for _, sess := range sessions {
			@card.Card() {
				@card.Content() {
					<div class="flex items-center justify-between gap-4">
						<div>
							<p class="font-medium">
								for i, part := range sess.Parts {
									if i > 0 {
										{ " · " }
									}
									if part.URL != "" {
										<a href={ templ.SafeURL(part.URL) } class="underline hover:text-foreground">{ part.Title }</a>
									} else {
										{ part.Title }
									}
								}
								if sess.Year > 0 {
									{ " (" + strconv.Itoa(sess.Year) + ")" }
								}
							</p>
							<p class="text-sm text-muted-foreground">
								{ timecode.FromDuration(sess.ViewOffset).Short() } / { timecode.FromDuration(sess.Duration).Short() }
							</p>
						</div>
						if sess.MediaID != "" {
							<a
								href={ templ.SafeURL(sess.ResumeURL()) }
								class="inline-flex shrink-0 items-center justify-center rounded-md bg-primary text-primary-foreground px-3 py-1.5 text-xs font-medium hover:bg-primary/90 transition-colors"
							>
								Clip now
							</a>
						}
					</div>
				}
			}
		}
	</div>
}

// TokenRejectedNotice explains that the bound Plex server refuses the token
// Outtake stored for it, and how to recover.
templ TokenRejectedNotice() {
	<p role="status" class="rounded-md border border-destructive/50 bg-destructive/10 px-3 py-2 text-sm text-destructive" data-token-rejected>
		Plex refused the token saved for this server. Sign out and sign in again to refresh it, or forget the server on the <a href="/servers" class="underline">Servers</a> page and select it again.
	</p>
}
