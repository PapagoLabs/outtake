package pages

import (
	"github.com/PapagoLabs/outtake/internal/web/view"
	"github.com/PapagoLabs/outtake/internal/web/assets"
	"github.com/PapagoLabs/outtake/internal/plex/identity"
	"github.com/PapagoLabs/outtake/internal/web/components/brand"
	"github.com/PapagoLabs/outtake/internal/web/components/button"
	"github.com/PapagoLabs/outtake/internal/web/components/card"
	"github.com/PapagoLabs/outtake/internal/web/components/csrf"
	"github.com/PapagoLabs/outtake/internal/web/components/flash"
	"github.com/PapagoLabs/outtake/internal/web/components/input"
	"github.com/PapagoLabs/outtake/internal/web/components/label"
	"github.com/PapagoLabs/outtake/internal/web/theme"
	"github.com/PapagoLabs/outtake/internal/web/utils"
)

// LoginProps carries the Plex authorization URL.
type LoginProps struct {
	AuthURL string
}

// Login renders the standalone sign-in document.
//
// Parameters:
//   - props: Plex authorization URL.
templ Login(props LoginProps) {
	<!DOCTYPE html>
	<html lang="en" class="dark" data-palette="plex" data-palettes={ theme.IDList() }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Login - Outtake</title>
			@brand.IconHead()
			<script src={ assets.URL("js/theme.js") }></script>
			<link href={ assets.URL("css/output.css") } rel="stylesheet"/>
			<script src={ assets.URL("js/htmx.min.js") }></script>
			<script src={ utils.ScriptURL("/assets/js/app.js") } defer></script>
			@input.Script()
			@label.Script()
			if token := identity.CSRFToken(ctx); token != "" {
				<meta name="csrf-token" content={ token }/>
			}
		</head>
		<body
			class="min-h-screen bg-background text-foreground flex items-center justify-center"
			if headers := identity.CSRFHeaderJSON(ctx); headers != "" {
				hx-headers:inherited={ headers }
			}
		>
			<div class="w-full max-w-md p-8">
				@flash.Slot(view.FailureFromContext(ctx))
				@card.Card() {
					@card.Header(card.HeaderProps{Class: "items-center text-center"}) {
						<img src={ assets.URL("brand/mascot-128.png") } width="80" height="80" alt="" class="size-20"/>
						@card.Title() {
							Outtake
						}
					}
					@card.Content() {
						<div id="plex-error" class="mb-4 hidden rounded-md bg-destructive/10 border border-destructive/20 p-3 text-sm text-destructive"></div>
						@button.Button(button.Props{ID: "plex-login", Type: button.TypeButton, FullWidth: true}) {
							Login With Plex
						}
						<div id="auth-status" class="mt-4 hidden text-center text-sm text-muted-foreground" role="status" data-status-url="/api/auth/status">
							Waiting for Plex…
						</div>
						<div class="relative my-4">
							<div class="absolute inset-0 flex items-center"><div class="w-full border-t"></div></div>
							<div class="relative flex justify-center text-xs uppercase"><span class="bg-card px-2 text-muted-foreground">Or</span></div>
						</div>
						<form action="/api/auth/login" method="POST" class="flex flex-col gap-4">
							@csrf.Field()
							<div class="flex flex-col gap-2">
								@label.Label(label.Props{For: "manual-token"}) {
									Plex Token
								}
								@input.Input(input.Props{ID: "manual-token", Name: "token", Type: "password", Placeholder: "Paste a Plex token"})
							</div>
							@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
								Login
							}
						</form>
					}
				}
			</div>
			<script src={ assets.URL("js/login.js") }></script>
		</body>
	</html>
}
