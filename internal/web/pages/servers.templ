package pages

import (
	"strconv"

	"github.com/PapagoLabs/outtake/internal/web/components/button"
	"github.com/PapagoLabs/outtake/internal/web/components/card"
	"github.com/PapagoLabs/outtake/internal/web/components/layout"
	"github.com/PapagoLabs/outtake/internal/web/utils"
)

type ServerItem struct {
	Name    string
	Address string
	Port    int
	Scheme  string
	Token   string
	Local    bool
	Selected bool
}

type ServersProps struct {
	Servers []ServerItem
	Error   string
}

templ Servers(props ServersProps) {
	@layout.Layout(layout.Props{Title: "Plex Servers", Active: "servers"}) {
		<div class="flex flex-col gap-6 max-w-xl">
			<div>
				<h2 class="text-2xl font-bold tracking-tight">Select a Plex server</h2>
				<p class="text-muted-foreground">Choose the Media Server that holds the files you want to clip.</p>
			</div>
			if props.Error != "" {
				<div class="js-flash rounded-md bg-destructive/10 border border-destructive/20 p-3 text-sm text-destructive flex items-start justify-between gap-3">
					<span>{ props.Error }</span>
					<button type="button" class="js-flash-dismiss text-xs underline" aria-label="Dismiss">Dismiss</button>
				</div>
			}
			if len(props.Servers) == 0 {
				@card.Card() {
					@card.Content() {
						<p class="text-muted-foreground">No Plex servers were discovered for this account.</p>
					}
				}
			}
			for _, server := range props.Servers {
				@card.Card() {
					@card.Content() {
						<form action="/servers" method="POST" class="flex items-center justify-between gap-4">
							<input type="hidden" name="name" value={ server.Name }/>
							<input type="hidden" name="address" value={ server.Address }/>
							<input type="hidden" name="port" value={ strconv.Itoa(server.Port) }/>
							<input type="hidden" name="scheme" value={ server.Scheme }/>
							<input type="hidden" name="token" value={ server.Token }/>
							<div>
								<p class="font-medium">
									{ server.Name }
									if server.Selected {
										<span class="ml-2 text-xs font-normal text-muted-foreground">Current</span>
									}
								</p>
								<p class="text-sm text-muted-foreground break-all">
									{ server.Scheme }://{ server.Address }:{ strconv.Itoa(server.Port) }
									if server.Local {
										<span>(local)</span>
									} else {
										<span>(remote)</span>
									}
								</p>
							</div>
							@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
								Use this server
							}
						</form>
					}
				}
			}
			@card.Card() {
				@card.Content() {
					<form action="/servers" method="POST" class="flex flex-col gap-3">
						<div>
							<p class="font-medium">Custom server URL</p>
							<p class="text-sm text-muted-foreground">Use an FQDN or ingress address, such as https://plex.example.com.</p>
						</div>
						<input type="url" name="customUrl" placeholder="https://plex.example.com" class={ utils.ControlClass }/>
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Class: "self-start"}) {
							Use this URL
						}
					</form>
				}
			}
		</div>
	}
}
