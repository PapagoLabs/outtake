package pages

import (
	"strconv"

	"github.com/PapagoLabs/outtake/internal/web/components/badge"
	"github.com/PapagoLabs/outtake/internal/web/components/button"
	"github.com/PapagoLabs/outtake/internal/web/components/card"
	"github.com/PapagoLabs/outtake/internal/web/components/csrf"
	"github.com/PapagoLabs/outtake/internal/web/components/layout"
	"github.com/PapagoLabs/outtake/internal/web/utils"
	"github.com/PapagoLabs/outtake/internal/web/view"
)

// ServersProps carries the discovered servers.
type ServersProps struct {
	Servers []view.ServerItem
	// Bound is true when a server is in use, which offers to forget it.
	Bound bool
	// TokenRejected reports that the bound server refuses its stored token.
	TokenRejected bool
}

// serverSelectedClass is the treatment the server already in use carries.
const serverSelectedClass = "bg-muted ring-2 ring-sidebar-primary"

// serverRow renders one discovered server as the form that selects it.
//
// Parameters:
//   - server: Discovered server.
templ serverRow(server view.ServerItem) {
	@card.Card(card.Props{Class: utils.IfElse(server.Selected, serverSelectedClass, "")}) {
		@card.Content() {
			<form action="/servers" method="POST" class="flex items-center justify-between gap-4">
				@csrf.Field()
				<input type="hidden" name="server" value={ server.Key }/>
				<div>
					<p
						class={ utils.TwMerge(
							"font-medium",
							utils.If(server.Selected, "flex flex-wrap items-center gap-2"),
						) }
					>
						{ server.Name }
						if server.Selected {
							@badge.Badge(badge.Props{
								Variant:    badge.VariantDefault,
								Attributes: templ.Attributes{"aria-current": "true"},
							}) {
								In Use
							}
						}
					</p>
					<p class="text-sm text-muted-foreground break-all">
						{ server.Scheme }://{ server.Address }:{ strconv.Itoa(server.Port) }
						if server.Local {
							<span>(local)</span>
						} else if server.Relay {
							<span>(relay)</span>
						} else {
							<span>(remote)</span>
						}
					</p>
				</div>
				if server.Selected {
					@button.Button(button.Props{
						Type:     button.TypeSubmit,
						Size:     button.SizeSm,
						Variant:  button.VariantOutline,
						Disabled: true,
					}) {
						In Use
					}
				} else {
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
						Use This Server
					}
				}
			</form>
		}
	}
}

// Servers renders the server chooser and the custom URL form.
//
// Parameters:
//   - props: Discovered servers and the selection error.
templ Servers(props ServersProps) {
	@layout.Layout(layout.Props{Title: "Servers", Active: "servers"}) {
		<div class="flex flex-col gap-6 max-w-xl">
			<h2 class="text-2xl font-bold tracking-tight">Servers</h2>
			if props.Bound && props.TokenRejected {
				@TokenRejectedNotice()
			}
			if len(props.Servers) == 0 {
				@card.Card() {
					@card.Content() {
						<p class="text-muted-foreground">No Plex servers found for this account</p>
					}
				}
			}
			for _, server := range props.Servers {
				@serverRow(server)
			}
			@card.Card() {
				@card.Content() {
					<form action="/servers" method="POST" class="flex flex-col gap-3">
						@csrf.Field()
						<div>
							<p class="font-medium">Custom Server URL</p>
							<p class="text-sm text-muted-foreground">The address Outtake uses to reach the Plex server</p>
						</div>
						<input type="url" name="customUrl" placeholder="https://plex.example.com" class={ utils.ControlClass }/>
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Class: "self-start"}) {
							Use This URL
						}
					</form>
				}
			}
			if props.Bound {
				@card.Card() {
					@card.Content() {
						<form
							action="/servers/forget"
							method="POST"
							class="flex items-center justify-between gap-4"
							data-confirm="Forget this server? Outtake stops reading from Plex until a server is chosen again."
						>
							@csrf.Field()
							<div>
								<p class="font-medium">Forget Server</p>
								<p class="text-sm text-muted-foreground">Outtake stops reading from Plex until a server is chosen again</p>
							</div>
							@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantDestructive}) {
								Forget Server
							}
						</form>
					}
				}
			}
		</div>
	}
}
