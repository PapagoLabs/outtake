package pages

import (
	"strconv"

	"github.com/PapagoLabs/outtake/internal/clip/profile"
	"github.com/PapagoLabs/outtake/internal/web/components/badge"
	"github.com/PapagoLabs/outtake/internal/web/components/button"
	"github.com/PapagoLabs/outtake/internal/web/components/card"
	"github.com/PapagoLabs/outtake/internal/web/components/checkbox"
	"github.com/PapagoLabs/outtake/internal/web/components/csrf"
	"github.com/PapagoLabs/outtake/internal/web/components/flash"
	"github.com/PapagoLabs/outtake/internal/web/components/input"
	"github.com/PapagoLabs/outtake/internal/web/components/label"
	"github.com/PapagoLabs/outtake/internal/web/components/layout"
	"github.com/PapagoLabs/outtake/internal/web/utils"
	"github.com/PapagoLabs/outtake/internal/web/view"
)

// ClipProfilesProps carries the stored profiles and the form choices.
type ClipProfilesProps struct {
	Profiles []view.ClipProfileItem
	Presets  []string
	Widths   []profile.OutputWidth
	Error    string
}

// ClipProfiles renders the stored clip profiles and the new profile form.
//
// Parameters:
//   - props: Stored profiles and form choices.
templ ClipProfiles(props ClipProfilesProps) {
	@layout.Layout(layout.Props{Title: "Clip Profiles", Active: "profiles"}) {
		<div class="flex flex-col gap-6 max-w-xl">
			<div>
				<h2 class="text-2xl font-bold tracking-tight">Clip profiles</h2>
				<p class="text-muted-foreground">Named encode settings used when creating video clips. Lower CRF is higher quality.</p>
			</div>
			@flash.Banner(props.Error)
			for _, profile := range props.Profiles {
				@card.Card() {
					@card.Content() {
						<form action={ templ.SafeURL("/settings/profiles/" + profile.ID) } method="POST" class="flex flex-col gap-4">
							@csrf.Field()
							<div class="flex items-center gap-2">
								if profile.IsDefault {
									@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
										Default
									}
								}
							</div>
							@profileFields("profile-"+profile.ID+"-", profile.Name, profile.CRF, profile.Preset, profile.AudioKbps, profile.MaxWidth, profile.KeepHDR, props.Presets, props.Widths)
							<div class="flex flex-wrap gap-2">
								@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
									Save
								}
								if !profile.IsDefault {
									@button.Button(button.Props{
										Type:    button.TypeSubmit,
										Size:    button.SizeSm,
										Variant: button.VariantOutline,
										Form:    "default-" + profile.ID,
									}) {
										Make default
									}
								}
								if len(props.Profiles) > 1 {
									@button.Button(button.Props{
										Type:    button.TypeSubmit,
										Size:    button.SizeSm,
										Variant: button.VariantDestructive,
										Form:    "delete-" + profile.ID,
									}) {
										Delete
									}
								}
							</div>
						</form>
						if !profile.IsDefault {
							<form id={ "default-" + profile.ID } action={ templ.SafeURL("/settings/profiles/" + profile.ID + "/default") } method="POST">
								@csrf.Field()
							</form>
						}
						if len(props.Profiles) > 1 {
							<form id={ "delete-" + profile.ID } action={ templ.SafeURL("/settings/profiles/" + profile.ID + "/delete") } method="POST" data-confirm="Delete this profile? This cannot be undone.">
								@csrf.Field()
							</form>
						}
					}
				}
			}
			@card.Card() {
				@card.Content() {
					<form action="/settings/profiles" method="POST" class="flex flex-col gap-4">
						@csrf.Field()
						<div>
							<p class="font-medium">New profile</p>
							<p class="text-sm text-muted-foreground">CRF 18–28 is typical. Slower presets take longer and compress more efficiently.</p>
						</div>
						@profileFields("new-", "", 23, "medium", 192, 1920, false, props.Presets, props.Widths)
						<label class="flex items-center gap-2 text-sm">
							@checkbox.Checkbox(checkbox.Props{Name: "isDefault", Value: "1", Class: "rounded border-input"})
							Set as default
						</label>
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Class: "self-start"}) {
							Add profile
						}
					</form>
				}
			}
		</div>
	}
}

// profileFields renders the shared name, CRF, preset, bitrate, and width fields.
//
// Parameters:
//   - idPrefix: Id and name prefix that keeps two forms apart.
//   - name: Current profile name.
//   - crf: Current CRF value.
//   - preset: Current encoder preset.
//   - audioKbps: Current audio bitrate in kbps.
//   - maxWidth: Current export resolution.
//   - keepHDR: Whether video clips from HDR sources keep HDR.
//   - presets: Encoder presets to choose from.
//   - widths: Export resolutions to choose from.
templ profileFields(idPrefix, name string, crf int, preset string, audioKbps, maxWidth int, keepHDR bool, presets []string, widths []profile.OutputWidth) {
	<div class="flex flex-col gap-2">
		@label.Label(label.Props{For: idPrefix + "name"}) {
			Name
		}
		@input.Input(input.Props{ID: idPrefix + "name", Name: "name", Type: input.TypeText, Value: name, Placeholder: "Archive"})
	</div>
	<div class="grid gap-4 sm:grid-cols-2">
		<div class="flex flex-col gap-2">
			@label.Label(label.Props{For: idPrefix + "crf"}) {
				CRF
			}
			@input.Input(input.Props{ID: idPrefix + "crf", Name: "crf", Type: input.TypeNumber, Value: strconv.Itoa(crf), Attributes: map[string]any{"min": "0", "max": "51"}})
		</div>
		<div class="flex flex-col gap-2">
			@label.Label(label.Props{For: idPrefix + "preset"}) {
				Encoder preset
			}
			<select id={ idPrefix + "preset" } name="preset" class={ utils.ControlClass }>
				for _, option := range presets {
					if option == preset {
						<option value={ option } selected>{ option }</option>
					} else {
						<option value={ option }>{ option }</option>
					}
				}
			</select>
		</div>
		<div class="flex flex-col gap-2">
			@label.Label(label.Props{For: idPrefix + "audio"}) {
				Audio bitrate (kbps)
			}
			@input.Input(input.Props{ID: idPrefix + "audio", Name: "audioKbps", Type: input.TypeNumber, Value: strconv.Itoa(audioKbps), Attributes: map[string]any{"min": "64", "max": "640"}})
		</div>
		<div class="flex flex-col gap-2">
			@label.Label(label.Props{For: idPrefix + "width"}) {
				Max resolution
			}
			<select id={ idPrefix + "width" } name="maxWidth" class={ utils.ControlClass }>
				for _, option := range widths {
					if option.Width == maxWidth {
						<option value={ strconv.Itoa(option.Width) } selected>{ option.Label }</option>
					} else {
						<option value={ strconv.Itoa(option.Width) }>{ option.Label }</option>
					}
				}
			</select>
		</div>
	</div>
	<label class="flex items-center gap-2 text-sm">
		@checkbox.Checkbox(checkbox.Props{ID: idPrefix + "keephdr", Name: "keepHdr", Value: "1", Checked: keepHDR, Class: "rounded border-input"})
		Keep HDR
	</label>
	<p class="text-sm text-muted-foreground">Video clips from an HDR source keep HDR, in a 10-bit HEVC file. Turn it off to convert them to SDR, which most social sites need. A clip takes this setting each time it renders, so a finished clip keeps its file until you regenerate it.</p>
}
