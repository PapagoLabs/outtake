package pages

templ NavLibraries(libs []LibraryItem) {
	for _, lib := range libs {
		<a
			href={ templ.SafeURL("/media?library=" + lib.ID) }
			class="px-3 py-1.5 rounded-md text-xs font-medium text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground transition-colors"
		>
			{ lib.Title }
		</a>
	}
}
