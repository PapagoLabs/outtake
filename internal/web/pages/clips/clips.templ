package clips

import (
	viewclip "github.com/PapagoLabs/outtake/internal/web/view/clip"
	"github.com/PapagoLabs/outtake/internal/web/components/card"
	"github.com/PapagoLabs/outtake/internal/web/components/clip"
	"github.com/PapagoLabs/outtake/internal/web/components/layout"
)

type ClipsProps struct {
	Items  []viewclip.ClipItem
	Status string
	Type   string
	Query  string
	Sort   string
}

func clipsFiltered(props ClipsProps) bool {
	return props.Status != "" || props.Type != "" || props.Query != ""
}

templ Clips(props ClipsProps) {
	@layout.Layout(layout.Props{Title: "Clips", Active: "clips"}) {
		<div class="flex flex-col gap-6">
			<div class="flex items-center justify-between gap-4">
				<div>
					<h2 class="text-2xl font-bold tracking-tight">Clips</h2>
					<p class="text-muted-foreground">Manage your generated video clips, GIFs, and screenshots.</p>
				</div>
				<a href="/media" class="inline-flex items-center justify-center rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-accent">
					New from library
				</a>
			</div>
			@clip.ListToolbar(clip.ListToolbarProps{
				Action:  "/clips",
				Target:  "clip-list",
				PushURL: true,
				Status:  props.Status,
				Type:    props.Type,
				Query:   props.Query,
				Sort:    props.Sort,
			})
			if props.Status != "" {
				<p class="text-sm text-muted-foreground">Showing { props.Status } clips. <a href="/clips" class="underline hover:text-foreground">Show all</a></p>
			}
			<div id="clip-list" class="flex flex-col gap-6">
				@ClipsList(props)
			</div>
		</div>
	}
}

templ ClipsList(props ClipsProps) {
	if len(props.Items) == 0 {
		@card.Card() {
			@card.Content() {
				<div class="text-center py-12 text-muted-foreground">
					if clipsFiltered(props) {
						<p>No clips match these filters.</p>
					} else {
						<p>No clips yet. Browse your media library and create your first clip.</p>
						<a href="/media" class="mt-4 inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-4 py-2 text-sm font-medium hover:bg-primary/90 transition-colors">
							Browse Media
						</a>
					}
				</div>
			}
		}
	}
	for _, item := range props.Items {
		@clip.ClipCard(item)
	}
}
