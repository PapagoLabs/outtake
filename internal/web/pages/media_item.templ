package pages

import (
	"strconv"

	"github.com/PapagoLabs/outtake/internal/media"
	"github.com/PapagoLabs/outtake/internal/web/components/button"
	"github.com/PapagoLabs/outtake/internal/web/components/card"
	"github.com/PapagoLabs/outtake/internal/web/components/clip"
	"github.com/PapagoLabs/outtake/internal/web/components/csrf"
	"github.com/PapagoLabs/outtake/internal/web/components/flash"
	"github.com/PapagoLabs/outtake/internal/web/components/input"
	"github.com/PapagoLabs/outtake/internal/web/components/label"
	"github.com/PapagoLabs/outtake/internal/web/components/layout"
	"github.com/PapagoLabs/outtake/internal/web/components/quality"
	"github.com/PapagoLabs/outtake/internal/web/utils"
	"github.com/PapagoLabs/outtake/internal/web/view"
)

type MediaItemPageProps struct {
	ID            string
	Title         string
	Type          string
	Duration      float64
	MaxDur        int
	Clips         []view.ClipItem
	ClipStatus    string
	ClipType      string
	ClipQuery     string
	ClipSort      string
	Profiles      []view.ClipProfileOption
	AudioTracks   []view.AudioTrackOption
	Error         string
	PreviewID     string
	StartTime     float64
	EndTime       float64
	CropBlackBars bool
	WebSafeColor  bool
	Crumbs        []view.Crumb
	LibraryID     string
}

templ MediaItemPage(props MediaItemPageProps) {
	@layout.Layout(layout.Props{Title: props.Title, Active: mediaNavActive(props.LibraryID), Library: props.LibraryID}) {
		<div class="flex flex-col gap-8 max-w-5xl">
			<div>
				if len(props.Crumbs) > 0 {
					<nav class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
						for i, crumb := range props.Crumbs {
							if i > 0 {
								<span>/</span>
							}
							if crumb.URL != "" {
								<a href={ templ.SafeURL(crumb.URL) } class="hover:text-foreground">{ crumb.Title }</a>
							} else {
								<span class="text-foreground">{ crumb.Title }</span>
							}
						}
					</nav>
				} else {
					<a href="/media" class="text-sm text-muted-foreground hover:text-foreground">Media Libraries</a>
				}
				<h2 class="text-2xl font-bold tracking-tight mt-2">{ props.Title }</h2>
				<p class="text-muted-foreground capitalize">
					{ props.Type }
					if props.Duration > 0 {
						<span> · { media.FromSeconds(props.Duration).HMS() }</span>
					}
				</p>
			</div>
			@flash.Banner(props.Error)
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Plex playback
					}
					@card.Description() {
						Watch in Plex on any client. Outtake reads the current position.
					}
				}
				@card.Content() {
					<div hx-get={ "/media/item/" + props.ID + "/playback" } hx-trigger="load, every 2s" hx-swap="innerHTML"></div>
				}
			}
			if props.PreviewID != "" {
				<video class="w-full rounded-md bg-black" controls preload="metadata">
					<source src={ "/previews/" + props.PreviewID } type="video/mp4"/>
				</video>
			}
			@card.Card() {
				@card.Header() {
					@card.Title() {
						New export
					}
					@card.Description() {
						Set start and end from Plex, preview the segment, then save.
					}
				}
				@card.Content() {
					<form id="clip-form" class="flex flex-col gap-4" data-export-form data-max-dur={ strconv.Itoa(props.MaxDur) }>
						@csrf.Field()
						<input type="hidden" name="mediaId" value={ props.ID }/>
						<input type="hidden" name="mediaTitle" value={ props.Title }/>
						<input type="hidden" name="mediaType" value={ props.Type }/>
						<div class="flex flex-col gap-2">
							@label.Label(label.Props{For: "clipType"}) {
								Export as
							}
							<select id="clipType" name="clipType" class={ utils.ControlClass }>
								<option value="clip">Video clip</option>
								<option value="gif">GIF</option>
								<option value="screenshot">Screenshot</option>
							</select>
						</div>
						<div class="flex flex-col gap-2">
							@label.Label(label.Props{For: "name"}) {
								Clip name
							}
							@input.Input(input.Props{ID: "name", Name: "name", Placeholder: "Optional name", Value: props.Title})
						</div>
						<div class="grid gap-4 sm:grid-cols-2">
							<div class="flex flex-col gap-2">
								<div class="grid">
									<div class="col-start-1 row-start-1 flex" data-export-for="clip,gif">
										@label.Label(label.Props{For: "startTime"}) {
											Start
										}
									</div>
									<div class="col-start-1 row-start-1 flex" data-export-for="screenshot">
										@label.Label(label.Props{For: "startTime"}) {
											Time
										}
									</div>
								</div>
								<input id="startTime" name="startTime" type="text" inputmode="decimal" placeholder="00:00:00.000" value={ media.FromSeconds(props.StartTime).String() } class={ utils.ControlClass }/>
							</div>
							<div class="flex flex-col gap-2" data-export-for="clip,gif">
								@label.Label(label.Props{For: "endTime"}) {
									End
								}
								<input id="endTime" name="endTime" type="text" inputmode="decimal" placeholder="00:00:00.000" value={ media.FromSeconds(props.EndTime).String() } class={ utils.ControlClass }/>
							</div>
						</div>
						<input type="hidden" id="duration" name="duration" value="10"/>
						<p class="text-sm text-muted-foreground" data-export-for="clip,gif">Duration: <span data-duration-label id="duration-label">{ media.FromSeconds(props.EndTime - props.StartTime).String() }</span> (max { media.FromSeconds(float64(props.MaxDur)).String() }) <span data-duration-warning id="duration-warning" class="hidden text-destructive">Clamped to the maximum duration.</span></p>
						<div class="grid gap-4 sm:grid-cols-2">
							<div class="flex flex-col gap-2" data-export-for="clip">
								@label.Label(label.Props{For: "quality"}) {
									Profile
								}
								@quality.QualitySelect("quality", props.Profiles, "")
							</div>
							if len(props.AudioTracks) > 0 {
								<div class="flex flex-col gap-2" data-export-for="clip">
									@label.Label(label.Props{For: "audioIndex"}) {
										Audio track
									}
									@quality.AudioSelect("audioIndex", props.AudioTracks, 0)
								</div>
							}
							<div class="flex flex-col gap-2" data-export-for="gif">
								@label.Label(label.Props{For: "width"}) {
									GIF width (px)
								}
								<input id="width" name="width" type="number" min="120" max="1920" value="480" class={ utils.ControlClass }/>
							</div>
							<div class="flex flex-col gap-2" data-export-for="gif">
								@label.Label(label.Props{For: "fps"}) {
									GIF frames per second
								}
								<input id="fps" name="fps" type="number" min="5" max="30" value="10" class={ utils.ControlClass }/>
							</div>
						</div>
						@clip.CropBlackBarsField(props.CropBlackBars)
						@clip.WebSafeColorField(props.WebSafeColor)
						<div class="flex gap-3">
							<button type="submit" formaction="/api/clips/preview" formmethod="post" class="js-export-submit inline-flex items-center justify-center rounded-md border px-4 py-2 text-sm font-medium hover:bg-accent">
								Preview
							</button>
							@button.Button(button.Props{Type: button.TypeSubmit, Class: "js-export-submit", Attributes: map[string]any{"formaction": "/api/clips", "formmethod": "post"}}) {
								Save clip
							}
						</div>
					</form>
				}
			}
			<div class="flex flex-col gap-4">
				<h3 class="text-lg font-semibold">Clips from this item</h3>
				@clip.ListToolbar(clip.ListToolbarProps{
					Action:  "/media/item/" + props.ID + "/clips",
					Target:  "item-clip-list",
					PushURL: false,
					Status:  props.ClipStatus,
					Type:    props.ClipType,
					Query:   props.ClipQuery,
					Sort:    props.ClipSort,
				})
				<div id="item-clip-list" class="flex flex-col gap-4">
					@ItemClipList(props.Clips, props.ClipStatus != "" || props.ClipType != "" || props.ClipQuery != "")
				</div>
			</div>
		</div>
		<div id="clip-form-config" data-max-dur={ strconv.Itoa(props.MaxDur) } class="hidden"></div>
		<script src="/assets/js/media-item.js"></script>
	}
}

templ ItemClipList(items []view.ClipItem, filtered bool) {
	if len(items) == 0 {
		if filtered {
			<p class="text-sm text-muted-foreground">No clips match these filters.</p>
		} else {
			<p class="text-sm text-muted-foreground">No clips yet.</p>
		}
	}
	for _, item := range items {
		@clip.ClipCard(item)
	}
}
