package pages

import (
	"github.com/PapagoLabs/outtake/internal/web/assets"
	"strconv"
	"time"

	"github.com/PapagoLabs/outtake/internal/clip"
	"github.com/PapagoLabs/outtake/internal/clip/profile"
	"github.com/PapagoLabs/outtake/internal/timecode"
	"github.com/PapagoLabs/outtake/internal/web/components/button"
	"github.com/PapagoLabs/outtake/internal/web/components/card"
	clipcard "github.com/PapagoLabs/outtake/internal/web/components/clip"
	"github.com/PapagoLabs/outtake/internal/web/components/csrf"
	"github.com/PapagoLabs/outtake/internal/web/components/flash"
	"github.com/PapagoLabs/outtake/internal/web/components/input"
	"github.com/PapagoLabs/outtake/internal/web/components/label"
	"github.com/PapagoLabs/outtake/internal/web/components/layout"
	"github.com/PapagoLabs/outtake/internal/web/components/player"
	"github.com/PapagoLabs/outtake/internal/web/components/progress"
	"github.com/PapagoLabs/outtake/internal/web/components/quality"
	"github.com/PapagoLabs/outtake/internal/web/utils"
	"github.com/PapagoLabs/outtake/internal/web/view"
)

const (
	// invalidSubmitClass is the styling an export button takes while its selection is out of bounds.
	invalidSubmitClass = "outline-2 outline-destructive outline-offset-2"

	// defaultExportType is the export type prefilled in the New export form.
	defaultExportType = clip.TypeClip
)

// exportTypeIs reports whether an export type option is the current choice.
//
// Parameters:
//   - chosen: Carried export type, empty when the form was never submitted.
//   - option: The export type this option represents.
//
// Returns:
//   - selected: True when the option is the current choice.
func exportTypeIs(chosen, option clip.Type) bool {
	if chosen == "" {
		chosen = defaultExportType
	}

	return chosen == option
}

// MediaItemPageProps carries the media item and its New export form state.
type MediaItemPageProps struct {
	ID          string
	Title       string
	Type        string
	Quality     string
	SourceHDR   bool
	Duration    time.Duration
	MaxDur      time.Duration
	Clips       []view.ClipItem
	ClipStatus  clip.Status
	ClipType    clip.Type
	ClipQuery   string
	ClipSort    string
	Profiles    []profile.ProfileOption
	AudioTracks []view.AudioTrackOption
	Error       string
	PreviewID   string
	// PreviewShownSDR marks a preview of an HDR clip tone mapped for an SDR
	// screen, which the page labels.
	PreviewShownSDR bool
	StartTime       time.Duration
	EndTime     time.Duration
	Export      view.ExportForm
	Crumbs      []view.Crumb
	LibraryID   string
}

// MediaItemPage renders the export form and clips for one media item.
//
// Parameters:
//   - props: Media item and export form state.
templ MediaItemPage(props MediaItemPageProps) {
	@layout.Layout(layout.Props{Title: props.Title, Active: mediaNavActive(props.LibraryID), Library: props.LibraryID}) {
		<div class="flex flex-col gap-8 max-w-5xl">
			<div>
				if len(props.Crumbs) > 0 {
					<nav class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
						for i, crumb := range props.Crumbs {
							if i > 0 {
								<span>/</span>
							}
							if crumb.URL != "" {
								<a href={ templ.SafeURL(crumb.URL) } class="hover:text-foreground">{ crumb.Title }</a>
							} else {
								<span class="text-foreground">{ crumb.Title }</span>
							}
						}
					</nav>
				} else {
					<a href="/media" class="text-sm text-muted-foreground hover:text-foreground">Media Libraries</a>
				}
				<h2 class="text-2xl font-bold tracking-tight mt-2">{ props.Title }</h2>
				<p class="text-muted-foreground capitalize">
					{ props.Type }
					if props.Quality != "" {
						<span>· { props.Quality }</span>
					}
					if props.Duration > 0 {
						<span>· { timecode.FromDuration(props.Duration).Short() }</span>
					}
				</p>
			</div>
			@flash.Banner(props.Error)
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Plex playback
					}
					@card.Description() {
						Watch in Plex on any client. Outtake reads the current position.
					}
				}
				@card.Content() {
					<div hx-get={ "/media/item/" + props.ID + "/playback" } hx-trigger="load, every 2s" hx-swap="innerHTML"></div>
				}
			}
			if props.PreviewID != "" {
				@player.Frame() {
					// The page script fills the badge in once the preview's status reports
					// what the finished file holds.
					@player.Badge(player.BadgeProps{
						ID:         "preview-format",
						Plays:      "preview",
						Hidden:     true,
						Attributes: templ.Attributes{"role": "status"},
					})
					<video
						id="preview-video"
						class="w-full rounded-md bg-black"
						controls
						preload="metadata"
						data-preview-id={ props.PreviewID }
						data-preview-start={ timecode.FromDuration(props.StartTime).FormatSeconds() }
					></video>
				}
				<div class="mt-3 flex items-center gap-3">
					@progress.Progress(progress.Props{
						ID:    "preview-progress",
						Max:   100,
						Value: 0,
						Size:  progress.SizeSm,
						Class: "hidden flex-1",
					})
					@button.Button(button.Props{
						ID:      "preview-cancel",
						Type:    button.TypeButton,
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
						Class:   "hidden",
						Attributes: map[string]any{
							"hx-delete":  "/api/clips/preview/" + props.PreviewID,
							"hx-swap":    "none",
							"hx-disable": "this",
						},
					}) {
						Cancel
					}
					@button.Button(button.Props{
						ID:      "preview-set-end",
						Type:    button.TypeButton,
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
						Class:   "hidden",
					}) {
						Set end here
					}
				</div>
				<p id="preview-status" class="mt-2 text-sm text-muted-foreground" role="status" aria-live="polite">
					Rendering preview…
				</p>
				if props.PreviewShownSDR {
					<p class="mt-1 text-sm text-muted-foreground" data-preview-sdr>
						Shown in SDR, because this screen does not show HDR. The saved clip keeps HDR.
					</p>
				}
			}
			@card.Card() {
				@card.Header() {
					@card.Title() {
						New export
					}
					@card.Description() {
						Set start and end from Plex, preview the segment, then save.
					}
				}
				@card.Content() {
					<form id="clip-form" class="flex flex-col gap-4" data-export-form data-max-dur={ strconv.FormatInt(int64(props.MaxDur/time.Second), 10) } data-media-dur={ timecode.FromDuration(props.Duration).FormatSeconds() }>
						@csrf.Field()
						<input type="hidden" name="mediaId" value={ props.ID }/>
						// The form script marks an HDR screen, so a preview is tone mapped
						// only where HDR cannot be shown.
						<input type="hidden" name="screenHdr" value="0" data-screen-hdr/>
						<input type="hidden" name="mediaTitle" value={ props.Title }/>
						<input type="hidden" name="mediaType" value={ props.Type }/>
						<div class="flex flex-col gap-2">
							@label.Label(label.Props{For: "clipType"}) {
								Export as
							}
							<select id="clipType" name="clipType" class={ utils.ControlClass }>
								<option value={ string(clip.TypeClip) } selected?={ exportTypeIs(props.Export.Type, clip.TypeClip) }>Video clip</option>
								<option value={ string(clip.TypeGIF) } selected?={ exportTypeIs(props.Export.Type, clip.TypeGIF) }>GIF</option>
								<option value={ string(clip.TypeScreenshot) } selected?={ exportTypeIs(props.Export.Type, clip.TypeScreenshot) }>Screenshot</option>
							</select>
						</div>
						<div class="flex flex-col gap-2">
							@label.Label(label.Props{For: "name"}) {
								Clip name
							}
							@input.Input(input.Props{ID: "name", Name: "name", Placeholder: "Optional name", Value: props.Export.Name})
						</div>
						<div class="grid gap-4 sm:grid-cols-2">
							<div class="flex flex-col gap-2">
								<div class="grid">
									<div class="col-start-1 row-start-1 flex items-baseline gap-2" data-export-for="clip,gif">
										@label.Label(label.Props{For: "startTime"}) {
											Start
										}
										<span data-start-time-error role="status" aria-live="polite" class="hidden text-xs text-destructive"></span>
									</div>
									<div class="col-start-1 row-start-1 flex items-baseline gap-2" data-export-for="screenshot">
										@label.Label(label.Props{For: "startTime"}) {
											Time
										}
										<span data-start-time-error role="status" aria-live="polite" class="hidden text-xs text-destructive"></span>
									</div>
								</div>
								<input id="startTime" name="startTime" type="text" inputmode="decimal" placeholder="00:00:00.000" value={ timecode.FromDuration(props.StartTime).String() } class={ utils.ControlClass }/>
							</div>
							<div class="flex flex-col gap-2" data-export-for="clip,gif">
								<div class="flex items-baseline gap-2">
									@label.Label(label.Props{For: "endTime"}) {
										End
									}
									<span data-end-time-error role="status" aria-live="polite" class="hidden text-xs text-destructive"></span>
								</div>
								<input id="endTime" name="endTime" type="text" inputmode="decimal" placeholder="00:00:00.000" value={ timecode.FromDuration(props.EndTime).String() } class={ utils.ControlClass }/>
							</div>
						</div>
						<input type="hidden" id="duration" name="duration" value="10"/>
						// The rendered window travels with the form, so a plain Preview finds it in the cache.
						<p class="text-sm text-muted-foreground" data-export-for="clip,gif">Duration: <span data-duration-label id="duration-label">{ timecode.FromDuration(props.EndTime - props.StartTime).Short() }</span> (max { timecode.FromDuration(props.MaxDur).Short() }) <span data-duration-warning id="duration-warning" role="status" aria-live="polite" class="sr-only"></span></p>
						<div class="grid gap-4 sm:grid-cols-2">
							<div class="flex flex-col gap-2" data-export-for="clip">
								@label.Label(label.Props{For: "quality"}) {
									Profile
								}
								@quality.QualitySelect("quality", props.Profiles, props.Export.Quality)
							</div>
							if len(props.AudioTracks) > 0 {
								<div class="flex flex-col gap-2" data-export-for="clip">
									@label.Label(label.Props{For: "audioIndex"}) {
										Audio track
									}
									@quality.AudioSelect("audioIndex", props.AudioTracks, props.Export.AudioIndex)
								</div>
							}
							<div class="flex flex-col gap-2" data-export-for="gif">
								@label.Label(label.Props{For: "width"}) {
									GIF width (px)
								}
								// These bounds mirror the server-side GIF width limits, which change for their own reasons.
								<input id="width" name="width" type="number" min="120" max="1920" value={ strconv.Itoa(view.GIFWidthOrDefault(props.Export.Width)) } class={ utils.ControlClass }/>
							</div>
							<div class="flex flex-col gap-2" data-export-for="gif">
								@label.Label(label.Props{For: "fps"}) {
									GIF frames per second
								}
								// These bounds mirror the server-side GIF frame rate limits.
								<input id="fps" name="fps" type="number" min="5" max="30" value={ strconv.Itoa(view.GIFFPSOrDefault(props.Export.FPS)) } class={ utils.ControlClass }/>
							</div>
						</div>
						@clipcard.CropBlackBarsField(props.Export.CropBlackBars)
						<div class="flex gap-3">
							@button.Button(button.Props{
								ID:      "preview-button",
								Type:    button.TypeSubmit,
								Variant: button.VariantOutline,
								Class:   "js-export-submit",
								Attributes: map[string]any{
									"formaction":       "/api/clips/preview",
									"formmethod":       "post",
									"data-invalid-css": invalidSubmitClass,
								},
							}) {
								<span id="preview-button-label">Preview</span>
							}
							@button.Button(button.Props{
								Type:    button.TypeSubmit,
								Class:   "js-export-submit",
								Variant: button.VariantDefault,
								Attributes: map[string]any{
									"formaction":       "/api/clips",
									"formmethod":       "post",
									"data-invalid-css": invalidSubmitClass,
								},
							}) {
								Save clip
							}
						</div>
					</form>
				}
			}
			<div class="flex flex-col gap-4">
				<h3 class="text-lg font-semibold">Clips from this item</h3>
				@clipcard.ListToolbar(clipcard.ListToolbarProps{
					Action:  "/media/item/" + props.ID + "/clips",
					Target:  "item-clip-list",
					PushURL: false,
					Status:  props.ClipStatus,
					Type:    props.ClipType,
					Query:   props.ClipQuery,
					Sort:    props.ClipSort,
				})
				<div id="item-clip-list" class="flex flex-col gap-4">
					@ItemClipList(props.Clips, props.ClipStatus != "" || props.ClipType != "" || props.ClipQuery != "")
				</div>
			</div>
		</div>
		<div id="clip-form-config" data-max-dur={ strconv.FormatInt(int64(props.MaxDur/time.Second), 10) } data-media-dur={ timecode.FromDuration(props.Duration).FormatSeconds() } class="hidden"></div>
		@progress.Script()
		<script src={ assets.URL("js/media-item.js") }></script>
	}
}

// ItemClipList renders the clip cards, or the empty and filtered-empty messages.
//
// Parameters:
//   - items: Clips made from this item.
//   - filtered: A status, type, or query filter is set.
templ ItemClipList(items []view.ClipItem, filtered bool) {
	if len(items) == 0 {
		if filtered {
			<p class="text-sm text-muted-foreground">No clips match these filters.</p>
		} else {
			<p class="text-sm text-muted-foreground">No clips yet.</p>
		}
	}
	for _, item := range items {
		@clipcard.ClipCard(item)
	}
}
