package error

import (
	"github.com/PapagoLabs/outtake/internal/web/components/brand"
	"github.com/PapagoLabs/outtake/internal/web/theme"
)

type ErrorPageProps struct {
	Title   string
	Message string
	Status  int
}

templ ErrorPage(props ErrorPageProps) {
	<!DOCTYPE html>
	<html lang="en" class="dark" data-palette="plex" data-palettes={ theme.IDList() }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ props.Title } - Outtake</title>
			@brand.IconHead()
			<script src="/assets/js/theme.js"></script>
			<link href="/assets/css/output.css" rel="stylesheet"/>
			<script src="/assets/js/app.js" defer></script>
		</head>
		<body class="min-h-screen bg-background text-foreground flex items-center justify-center p-6">
			<div class="w-full max-w-md text-center flex flex-col gap-4">
				<img src="/assets/brand/mascot-128.png" width="64" height="64" alt="" class="size-16 mx-auto"/>
				<h1 class="text-2xl font-bold tracking-tight">{ props.Title }</h1>
				<p class="text-muted-foreground">{ props.Message }</p>
				<a href="/" class="inline-flex self-center items-center justify-center rounded-md bg-primary text-primary-foreground px-4 py-2 text-sm font-medium hover:bg-primary/90">
					Back to Outtake
				</a>
			</div>
		</body>
	</html>
}
