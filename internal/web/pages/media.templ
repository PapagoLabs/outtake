package pages

import (
	"github.com/PapagoLabs/outtake/internal/web/components/browse"
	"github.com/PapagoLabs/outtake/internal/web/components/input"
	"github.com/PapagoLabs/outtake/internal/web/components/label"
	"github.com/PapagoLabs/outtake/internal/web/components/layout"
	"github.com/PapagoLabs/outtake/internal/web/view"
)

// mediaNavActive returns the sidebar key to mark active for a media page.
//
// Parameters:
//   - libraryID: Selected library id, empty on the library chooser.
//
// Returns:
//   - active: Sidebar key, empty when a child library is in view.
func mediaNavActive(libraryID string) string {
	if libraryID == "" {
		return "media"
	}

	return ""
}

// Media renders the media library browse page.
//
// Parameters:
//   - props: Media library page state.
templ Media(props view.MediaProps) {
	@layout.Layout(layout.Props{Title: "Media Libraries", Active: mediaNavActive(props.LibraryID), Library: props.LibraryID}) {
		<div class="flex min-h-0 flex-1 flex-col gap-6">
			<div class="shrink-0">
				<h2 class="text-2xl font-bold tracking-tight">Media Libraries</h2>
			</div>
			<form hx-get="/media" hx-target="#media-browse" hx-swap="innerHTML" hx-push-url="true" hx-include="#media-list-sort" hx-indicator="#search-indicator" class="flex shrink-0 gap-2">
				if props.LibraryID != "" {
					<input type="hidden" name="library" value={ props.LibraryID }/>
				}
				<div class="flex-1">
					@label.Label(label.Props{For: "search", Class: "sr-only"}) {
						Search
					}
					@input.Input(input.Props{ID: "search", Name: "q", Placeholder: "Search titles", Value: props.Query})
				</div>
				<button type="submit" class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-4 py-2 text-sm font-medium hover:bg-primary/90 transition-colors">
					Search
				</button>
				<span id="search-indicator" class="htmx-indicator self-center text-sm text-muted-foreground">Searching…</span>
			</form>
			<div id="media-browse" class="flex min-h-0 flex-1 flex-col overflow-hidden">
				@browse.MediaBrowse(props)
			</div>
		</div>
	}
}
