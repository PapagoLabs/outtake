package pages

import (
	"github.com/PapagoLabs/outtake/internal/clip"
	"github.com/PapagoLabs/outtake/internal/web/components/card"
	clipcard "github.com/PapagoLabs/outtake/internal/web/components/clip"
	"github.com/PapagoLabs/outtake/internal/web/components/layout"
	"github.com/PapagoLabs/outtake/internal/web/routes"
	"github.com/PapagoLabs/outtake/internal/web/view"
)

// ClipsProps carries the clip list and its active filters.
type ClipsProps struct {
	Items  []view.ClipItem
	Status clip.Status
	Type   clip.Type
	Query  string
	Sort   string
	// Shared lists the clips shared with the installation's users.
	Shared bool
	// OfferShared shows the choice of the shared clips, once the installation
	// has another user to share them with.
	OfferShared bool
	// MoreURL loads the list's next page, empty when no clip follows.
	MoreURL string
	// Bulk describes the list's bulk actions.
	Bulk clipcard.BulkBarProps
}

// clipsFiltered reports whether any filter narrows the clip list.
//
// Parameters:
//   - props: Clip list state.
//
// Returns:
//   - ok: True when a status, type, query, or shared filter is set.
func clipsFiltered(props ClipsProps) bool {
	return props.Status != "" || props.Type != "" || props.Query != "" || props.Shared
}

// onlyShared reports whether the list shows the shared clips with no other
// filter set.
//
// Parameters:
//   - props: Clip list state.
//
// Returns:
//   - ok: True when only the shared filter is set.
func onlyShared(props ClipsProps) bool {
	return props.Shared && props.Status == "" && props.Type == "" && props.Query == ""
}

// Clips renders the clip list page.
//
// Parameters:
//   - props: Clip list state.
templ Clips(props ClipsProps) {
	@layout.Layout(layout.Props{Title: "Clips", Active: "clips"}) {
		<div class="flex flex-col gap-6">
			<div class="flex items-center justify-between gap-4">
				<h2 class="text-2xl font-bold tracking-tight">Clips</h2>
				<a href="/media" class="inline-flex items-center justify-center rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-accent">
					New From Library
				</a>
			</div>
			@clipcard.ListToolbar(clipcard.ListToolbarProps{
				ID:          routes.ClipListToolbar,
				Action:      "/clips",
				Target:      "clip-list",
				PushURL:     true,
				Status:      props.Status,
				Type:        props.Type,
				Query:       props.Query,
				Sort:        props.Sort,
				OfferShared: props.OfferShared,
				Shared:      props.Shared,
			})
			if props.Status != "" {
				<p class="text-sm text-muted-foreground">Showing { props.Status } clips <a href="/clips" class="underline hover:text-foreground">Show All</a></p>
			}
			@clipcard.BulkStatusLine(routes.ClipBulkStatus)
			<div id="clip-list" class="flex flex-col gap-6">
				@ClipsList(props)
			</div>
		</div>
	}
}

// ClipsList renders the clip cards, or the empty and filtered-empty messages.
//
// Parameters:
//   - props: Clip list state.
templ ClipsList(props ClipsProps) {
	@clipcard.BulkBar(props.Bulk)
	if len(props.Items) == 0 {
		@card.Card() {
			@card.Content() {
				<div class="text-center py-12 text-muted-foreground">
					if onlyShared(props) {
						<p>No shared clips yet</p>
					} else if clipsFiltered(props) {
						<p>No clips match these filters</p>
					} else {
						<p>No clips yet. Choose a title in Media Libraries to make one.</p>
						<a href="/media" class="mt-4 inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-4 py-2 text-sm font-medium hover:bg-primary/90 transition-colors">
							Browse Media
						</a>
					}
				</div>
			}
		}
	}
	@ClipsMore(props)
}

// ClipsMore renders a page of clip cards and the sentinel for the next one.
//
// Parameters:
//   - props: Clip list state.
templ ClipsMore(props ClipsProps) {
	for _, item := range props.Items {
		@clipcard.ClipCard(item)
	}
	@clipcard.MoreClips(routes.TargetClipListMore, props.MoreURL)
}
