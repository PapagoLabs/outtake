{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":semanticCommits"],
  "postUpdateOptions": ["gomodTidy"],
  "platformAutomerge": false,
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "semanticCommitType": "chore"
    },
    {
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump",
      "semanticCommitType": "chore"
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "semanticCommitType": "chore",
      "enabled": true
    },
    {
      "description": "A new major version of a Go module is a new module path, so it only becomes a requirement when a direct dependency imports it. Mockery is excluded because go.mod marks the tool as indirect. The docs module is excluded because its Hugo modules are all indirect.",
      "matchManagers": ["gomod"],
      "matchFileNames": ["go.mod"],
      "matchDepTypes": ["indirect"],
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["!github.com/vektra/mockery/v3"],
      "enabled": false
    },
    {
      "description": "templ requires github.com/a-h/parse by commit, because parse has no tags. Parse moves only with templ, when a templ update requires a newer commit.",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/a-h/parse"],
      "enabled": false
    },
    {
      "description": "Group the Hugo modules of the documentation site",
      "matchManagers": ["gomod"],
      "matchFileNames": ["docs/go.mod"],
      "groupName": "docs hugo modules",
      "semanticCommitType": "docs"
    },
    {
      "description": "Automerge non-major updates",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Do not automerge the Go toolchain",
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
