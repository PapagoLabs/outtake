#
# Development Dockerfile for outtake.
# Builds the binary from source and bundles static ffmpeg/ffprobe.

ARG BASE_IMAGE=golang:1.27.1-alpine@sha256:3f6d04dc61331ee3c2fbbaad62d54412a84680f6a041d269a20a5270a078515b

FROM ${BASE_IMAGE} AS builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /build

COPY scripts/download-ffmpeg ./scripts/download-ffmpeg
RUN cd ./scripts/download-ffmpeg && go mod download && go run .

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go run github.com/a-h/templ/cmd/templ@v0.3.1020 generate
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o outtake .

FROM scratch

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /build/outtake /outtake
COPY --from=builder /build/ffmpeg /usr/bin/ffmpeg
COPY --from=builder /build/ffprobe /usr/bin/ffprobe

EXPOSE 8080

VOLUME ["/data"]

ENV OUTTAKE_DATABASE_PATH=/data/outtake.db
ENV OUTTAKE_STORAGE_PATH=/data/output
ENV OUTTAKE_LISTEN_ADDR=:8080
ENV OUTTAKE_FFMPEG_PATH=/usr/bin/ffmpeg
ENV OUTTAKE_FFPROBE_PATH=/usr/bin/ffprobe
ENV OUTTAKE_PUBLIC_BASE_URL=http://localhost:8080

USER 1000:1000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/outtake", "health"]

ENTRYPOINT ["/outtake"]
CMD ["server", "start"]
